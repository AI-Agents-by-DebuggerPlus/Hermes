<Window x:Class="Hermes.EnglishLearning.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes English Learning"
        Width="960"
        Height="640"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CardBackgroundBrush}"
        Foreground="{StaticResource RussianTextBrush}"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        Loaded="Window_OnLoaded"
        SizeChanged="Window_OnSizeChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="ChromeBar"
                Grid.Row="0"
                Background="{StaticResource ChromeBrush}"
                Padding="10,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Уроки…" Margin="0,0,8,0" Padding="10,4" Click="LibraryButton_OnClick" />
                    <Button Content="Открыть MD…" Margin="0,0,8,0" Padding="10,4" Click="OpenButton_OnClick" />
                    <Button Content="Настройки" Margin="0,0,8,0" Padding="10,4" Click="SettingsButton_OnClick" />
                    <Button Content="Лог" Margin="0,0,8,0" Padding="10,4" Click="LogButton_OnClick" />
                    <Button Content="Кэш TTS" Margin="0,0,8,0" Padding="10,4" Click="CacheTtsButton_OnClick"
                            ToolTip="Скачать озвучку всего урока в tts-cache без прослушивания" />
                    <Button x:Name="SpeakButton" Content="Озвучить" Margin="0,0,8,0" Padding="10,4" Click="SpeakButton_OnClick" />
                    <Button Content="◀" Width="40" Margin="0,0,4,0" Click="PrevButton_OnClick" />
                    <Button Content="▶" Width="40" Click="NextButton_OnClick" />
                </StackPanel>
                <TextBlock x:Name="ProgressText"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Нет урока" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                x:Name="CardHost"
                Padding="40,28,40,20"
                Background="{StaticResource CardBackgroundBrush}">
            <Grid>
                <Grid x:Name="CardsPanel"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center" />
            </Grid>
        </Border>

        <Border x:Name="StatusBar"
                Grid.Row="2"
                Background="{StaticResource ChromeBrush}"
                Padding="10,6">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="BatteryText"
                           DockPanel.Dock="Right"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="BT: …" />

                <Border DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Padding="8,2"
                        Background="#161B22"
                        BorderBrush="#30343D"
                        BorderThickness="1"
                        CornerRadius="4"
                        MinWidth="200">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="♪"
                                   FontSize="14"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   ToolTip="Громкость озвучки внутри приложения (не микшер Windows / не кнопки на гарнитуре)"
                                   Foreground="#F0B90B" />
                        <TextBlock x:Name="VolumeValueText"
                                   DockPanel.Dock="Right"
                                   Width="28"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#EAECEF"
                                   Text="80" />
                        <Slider x:Name="VolumeSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="80"
                                VerticalAlignment="Center"
                                IsMoveToPointEnabled="True"
                                ValueChanged="VolumeSlider_OnValueChanged"
                                Foreground="#F0B90B">
                            <Slider.LayoutTransform>
                                <ScaleTransform ScaleY="1.1" />
                            </Slider.LayoutTransform>
                        </Slider>
                    </DockPanel>
                </Border>

                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="F — полный экран · Play/Pause — пауза или следующий экран · ↑↓ громкость" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
