<Window x:Class="Hermes.EnglishLearning.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes English Learning"
        Width="960"
        Height="640"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CardBackgroundBrush}"
        Foreground="{StaticResource RussianTextBrush}"
        KeyDown="Window_OnKeyDown"
        Loaded="Window_OnLoaded"
        SizeChanged="Window_OnSizeChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Chrome -->
        <Border Grid.Row="0"
                Background="{StaticResource ChromeBrush}"
                Padding="10,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="OpenButton"
                            Content="Открыть MD…"
                            Margin="0,0,8,0"
                            Padding="10,4"
                            Click="OpenButton_OnClick" />
                    <Button x:Name="SettingsButton"
                            Content="Supabase…"
                            Margin="0,0,8,0"
                            Padding="10,4"
                            Click="SettingsButton_OnClick" />
                    <Button x:Name="SpeakButton"
                            Content="Озвучить"
                            Margin="0,0,8,0"
                            Padding="10,4"
                            Click="SpeakButton_OnClick" />
                    <Button x:Name="PrevButton"
                            Content="◀"
                            Width="40"
                            Margin="0,0,4,0"
                            Click="PrevButton_OnClick" />
                    <Button x:Name="NextButton"
                            Content="▶"
                            Width="40"
                            Click="NextButton_OnClick" />
                </StackPanel>
                <TextBlock x:Name="ProgressText"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Нет урока" />
            </DockPanel>
        </Border>

        <!-- Cards -->
        <Border Grid.Row="1"
                x:Name="CardHost"
                Padding="48,36,48,24"
                Background="{StaticResource CardBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CardsPanel"
                            VerticalAlignment="Top" />
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource ChromeBrush}"
                Padding="10,6">
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Загрузите MD или дождитесь урока из Supabase. ← → для навигации." />
        </Border>
    </Grid>
</Window>
