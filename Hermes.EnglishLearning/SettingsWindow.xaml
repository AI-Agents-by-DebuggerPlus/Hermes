<Window x:Class="Hermes.EnglishLearning.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supabase / настройки"
        Width="520"
        Height="360"
        WindowStartupLocation="CenterOwner"
        Background="#121A28"
        Foreground="#D0D4DC"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,0,8" Text="Supabase URL" VerticalAlignment="Center" />
        <TextBox x:Name="UrlBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Padding="4" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,0,8" Text="Anon key" VerticalAlignment="Center" />
        <TextBox x:Name="KeyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Padding="4" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,0,8" Text="recipient_name" VerticalAlignment="Center" />
        <TextBox x:Name="RecipientBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Padding="4" />

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,0,8" Text="Poll (сек)" VerticalAlignment="Center" />
        <TextBox x:Name="PollBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Padding="4" Width="80" HorizontalAlignment="Left" />

        <CheckBox x:Name="AutoSpeakBox"
                  Grid.Row="4"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Margin="0,8,0,8"
                  Content="Автоозвучка при смене экрана"
                  Foreground="#D0D4DC" />

        <TextBlock Grid.Row="5"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   TextWrapping="Wrap"
                   Foreground="#8490A0"
                   Text="Hermes шлёт content с type=english_lesson на recipient_name=EnglishLearning. Аудио через Supabase не передаём — TTS локально (SAPI)." />

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
            <Button Content="Сохранить" Width="100" IsDefault="True" Click="Save_OnClick" />
        </StackPanel>
    </Grid>
</Window>
