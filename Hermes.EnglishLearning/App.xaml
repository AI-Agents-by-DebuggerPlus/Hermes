<Application x:Class="Hermes.EnglishLearning.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0A1628" />
            <SolidColorBrush x:Key="EnglishTextBrush" Color="#F8D12F" />
            <SolidColorBrush x:Key="RussianTextBrush" Color="#D0D4DC" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#8490A0" />
            <SolidColorBrush x:Key="ChromeBrush" Color="#121A28" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
