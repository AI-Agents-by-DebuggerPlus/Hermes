<Window x:Class="Hermes.EnglishLearning.LessonLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Уроки (MD)"
        Width="560"
        Height="420"
        WindowStartupLocation="CenterOwner"
        Background="#0B0E11"
        Foreground="#EAECEF">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,8"
                   Foreground="#AAB2C0"
                   Text="Файлы из папок SampleLessons и lessons рядом с EXE." />

        <ListBox x:Name="FilesList"
                 Grid.Row="1"
                 Background="#161B22"
                 Foreground="#EAECEF"
                 BorderBrush="#30343D"
                 DisplayMemberPath="Display"
                 SelectionMode="Extended" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Обновить" Width="90" Margin="0,0,8,0" Click="Refresh_OnClick" />
            <Button Content="Удалить" Width="90" Margin="0,0,8,0" Click="Delete_OnClick" />
            <Button Content="Открыть" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Open_OnClick" />
            <Button Content="Закрыть" Width="90" IsCancel="True" Click="Close_OnClick" />
        </StackPanel>
    </Grid>
</Window>
