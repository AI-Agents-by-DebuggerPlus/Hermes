<UserControl x:Class="Hermes.BinanceDemoFuturesTerminal.Controls.QuantityUnitSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ToggleButton x:Name="UnitToggle" Height="30" MinWidth="72" Padding="8,0"
                      Background="#20242B" Foreground="#EAECEF" BorderBrush="#2B3139" BorderThickness="1,1,1,1"
                      FontSize="11" FontWeight="Bold" Cursor="Hand"
                      IsChecked="{Binding IsUnitSelectorOpen, Mode=TwoWay}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0,4,4,0" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter/>
                            <TextBlock Text=" ▾" Foreground="#848E9C" FontSize="9"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </ToggleButton.Template>
            <TextBlock Text="{Binding QuantityUnitButtonText, Mode=OneWay}"/>
        </ToggleButton>

        <Popup PlacementTarget="{Binding ElementName=UnitToggle}" Placement="Bottom"
               IsOpen="{Binding IsUnitSelectorOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#181A20" BorderBrush="#2B3139" BorderThickness="1" CornerRadius="8" Padding="12" MaxWidth="320">
                <StackPanel>
                    <TextBlock Text="Предпочтительная единица" Foreground="#848E9C" FontSize="10" Margin="0,0,0,10"/>

                    <!-- BTC / base asset -->
                    <Border CornerRadius="6" Padding="10" Margin="0,0,0,8" Cursor="Hand"
                            Background="#20242B" BorderBrush="#2B3139" BorderThickness="1"
                            MouseLeftButtonUp="OnSelectContracts">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsContractsMode, Mode=OneWay}" Value="True">
                                        <Setter Property="BorderBrush" Value="#EAECEF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedBaseAsset, Mode=OneWay}" Foreground="#EAECEF" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Foreground="#848E9C" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,0">
                                <Run Text="Ввод и отображение размера ордера в "/>
                                <Run Text="{Binding SelectedBaseAsset, Mode=OneWay}"/>
                                <Run Text="."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- USDT -->
                    <Border CornerRadius="6" Padding="10" Background="#20242B" BorderBrush="#2B3139" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUsdtQuantityMode, Mode=OneWay}" Value="True">
                                        <Setter Property="BorderBrush" Value="#EAECEF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="USDT" Foreground="#EAECEF" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="Ввод и отображение размера ордера в USDT. Чтобы разместить ордер, используя начальную маржу, выберите опцию «Начальная маржа» и введите сумму начальной маржи."
                                       Foreground="#848E9C" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,10"/>

                            <RadioButton GroupName="UsdtQtyMode" Content="Размер ордера" Foreground="#EAECEF" FontSize="10.5"
                                         IsChecked="{Binding IsUsdtOrderSizeMode, Mode=OneWay}" Margin="0,0,0,6"
                                         Command="{Binding SelectUsdtOrderSizeCommand}"/>
                            <RadioButton GroupName="UsdtQtyMode" Content="Начальная маржа" Foreground="#EAECEF" FontSize="10.5"
                                         IsChecked="{Binding IsUsdtInitialMarginMode, Mode=OneWay}"
                                         Command="{Binding SelectUsdtInitialMarginCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
