<UserControl x:Class="Hermes.BinanceDemoFuturesTerminal.Controls.CandlestickChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hermes.BinanceDemoFuturesTerminal.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600"
             Background="#181A20">
    <local:CandleChartCanvas x:Name="ChartCanvas"
                             Candles="{Binding Candles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             LastPrice="{Binding LastPrice, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
</UserControl>
