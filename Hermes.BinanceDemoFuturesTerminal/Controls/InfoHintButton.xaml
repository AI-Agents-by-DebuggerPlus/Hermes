<UserControl x:Class="Hermes.BinanceDemoFuturesTerminal.Controls.InfoHintButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <ToggleButton x:Name="HintToggle" Content="ℹ" Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                      FontSize="10" FontWeight="Bold" Foreground="#848E9C" Background="Transparent"
                      BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#EAECEF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <Popup PlacementTarget="{Binding ElementName=HintToggle}" Placement="Bottom"
               IsOpen="{Binding IsChecked, ElementName=HintToggle}" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#181A20" BorderBrush="#2B3139" BorderThickness="1" CornerRadius="6"
                    Padding="10" MaxWidth="280">
                <StackPanel>
                    <TextBlock Text="{Binding HintText, ElementName=Root}" Foreground="#EAECEF" FontSize="10"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
