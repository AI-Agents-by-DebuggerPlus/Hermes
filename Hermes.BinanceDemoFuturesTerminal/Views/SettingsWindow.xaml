<Window x:Class="Hermes.BinanceDemoFuturesTerminal.Views.SettingsWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Hermes.BinanceDemoFuturesTerminal.Controls"

        Title="Настройки — Hermes Futures Demo"

        Height="500" Width="520"

        Background="#0C0E12"

        WindowStartupLocation="CenterOwner"

        ResizeMode="NoResize">

    <Grid Margin="16">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <TextBlock Text="Binance Demo API" Foreground="#EAECEF" FontSize="15" FontWeight="Bold"/>



        <StackPanel Grid.Row="1" Margin="0,12,0,0">

            <TextBlock Text="API KEY" Foreground="#848E9C" FontSize="10" FontWeight="Bold"/>

            <TextBox Height="26" Margin="0,4,0,8" Background="#20242B" Foreground="#EAECEF"

                     BorderBrush="#2B3139" Padding="6,4"

                     Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="SECRET KEY" Foreground="#848E9C" FontSize="10" FontWeight="Bold"/>

            <PasswordBox x:Name="SecretBox" Height="26" Margin="0,4,0,0" Background="#20242B"

                         Foreground="#EAECEF" BorderBrush="#2B3139" Padding="6,4"

                         PasswordChanged="SecretBox_OnPasswordChanged"/>

        </StackPanel>



        <Grid Grid.Row="2" Margin="0,12,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"

                       Text="Ключи из Binance → Demo Trading → API Management"

                       Foreground="#848E9C" FontSize="10" TextWrapping="Wrap" Margin="0,0,8,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Content="Стереть ключи" Padding="12,6" Margin="0,0,8,0" Click="OnClearKeys"/>

                <Button Content="Сохранить ключи" Padding="16,6" FontWeight="Bold" Click="OnSaveApiKeys"/>

            </StackPanel>

        </Grid>



        <GroupBox Grid.Row="3" Header="Риск-менеджер" Foreground="#EAECEF" Margin="0,16,0,0" Padding="10">

            <StackPanel>

                <CheckBox Content="Включить проверки перед ордером" Foreground="#EAECEF"

                          IsChecked="{Binding RiskManagementEnabled}" Margin="0,0,0,10"/>



                <Grid Margin="0,0,0,6">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="100"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Макс. маржа на сделку (% депозита)" Foreground="#848E9C" VerticalAlignment="Center"/>
                        <ctrl:InfoHintButton HintText="Максимальная начальная маржа одного ордера в процентах от баланса кошелька USDT. Номинал = маржа × плечо. По умолчанию 1%."/>
                    </StackPanel>

                    <TextBox Grid.Column="1" Background="#20242B" Foreground="#EAECEF" BorderBrush="#2B3139"

                             Text="{Binding MaxOrderMarginPercent, UpdateSourceTrigger=PropertyChanged}"/>

                </Grid>



                <Grid Margin="0,0,0,6">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="100"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Макс. суммарная экспозиция (USDT)" Foreground="#848E9C" VerticalAlignment="Center"/>
                        <ctrl:InfoHintButton HintText="Суммарный номинал всех открытых позиций. Новый ордер не пройдёт, если текущая экспозиция + номинал ордера превысят лимит."/>
                    </StackPanel>

                    <TextBox Grid.Column="1" Background="#20242B" Foreground="#EAECEF" BorderBrush="#2B3139"

                             Text="{Binding MaxTotalExposureUsdt, UpdateSourceTrigger=PropertyChanged}"/>

                </Grid>



                <Grid Margin="0,0,0,6">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="100"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Макс. открытых позиций" Foreground="#848E9C" VerticalAlignment="Center"/>
                        <ctrl:InfoHintButton HintText="Максимальное число одновременно открытых позиций по разным инструментам."/>
                    </StackPanel>

                    <TextBox Grid.Column="1" Background="#20242B" Foreground="#EAECEF" BorderBrush="#2B3139"

                             Text="{Binding MaxOpenPositions, UpdateSourceTrigger=PropertyChanged}"/>

                </Grid>



                <Grid Margin="0,0,0,12">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="100"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Макс. плечо (проверка)" Foreground="#848E9C" VerticalAlignment="Center"/>
                        <ctrl:InfoHintButton HintText="Максимальное плечо, разрешённое риск-менеджером. Ордер не отправится, если плечо по инструменту выше лимита."/>
                    </StackPanel>

                    <TextBox Grid.Column="1" Background="#20242B" Foreground="#EAECEF" BorderBrush="#2B3139"

                             Text="{Binding MaxLeverage, UpdateSourceTrigger=PropertyChanged}"/>

                </Grid>



                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Дефолтный объём для агента (USDT)" Foreground="#848E9C"/>
                        <TextBlock Text="Если пользователь не указал объём — Hermes использует это значение."
                                   Foreground="#5E6673" FontSize="9" TextWrapping="Wrap" Margin="0,2,8,0"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Background="#20242B" Foreground="#EAECEF" BorderBrush="#2B3139"
                             Text="{Binding DefaultAgentOrderUsdt, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Button Content="Сохранить риск-менеджер" Padding="16,6" FontWeight="Bold"

                        HorizontalAlignment="Right" Click="OnSaveRisk"/>

            </StackPanel>

        </GroupBox>



        <TextBlock Grid.Row="4" VerticalAlignment="Bottom" Text="{Binding SettingsFilePath}"

                   Foreground="#848E9C" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0"/>

    </Grid>

</Window>


