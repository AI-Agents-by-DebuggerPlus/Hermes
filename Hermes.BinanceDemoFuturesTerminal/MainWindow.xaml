<Window x:Class="Hermes.BinanceDemoFuturesTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Hermes.BinanceDemoFuturesTerminal.ViewModels"
        xmlns:ctrl="clr-namespace:Hermes.BinanceDemoFuturesTerminal.Controls"
        mc:Ignorable="d"
        Title="Hermes Binance FUTURES DEMO Terminal" Height="820" Width="1380"
        Background="#0C0E12" WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Премиальная палитра цветов -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0E11"/>
        <SolidColorBrush x:Key="BgCard" Color="#181A20"/>
        <SolidColorBrush x:Key="BorderSlate" Color="#2B3139"/>
        <SolidColorBrush x:Key="TextMain" Color="#EAECEF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#848E9C"/>
        <SolidColorBrush x:Key="BullishGreen" Color="#0ECB81"/>
        <SolidColorBrush x:Key="BearishRed" Color="#F6465D"/>
        <SolidColorBrush x:Key="CyanActive" Color="#02A4FF"/>

        <!-- Стили кнопок -->
        <Style x:Key="BuyBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0ECB81"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0bba75"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SellBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F6465D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e03e53"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2B3139"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#383f49"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LeverageChipBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2B3139"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#383f49"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#848E9C"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PctBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#252930"/>
            <Setter Property="Foreground" Value="#848E9C"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B3139"/>
                    <Setter Property="Foreground" Value="#EAECEF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkLinkBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#02A4FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#38bdf8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для полей ввода -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#20242B"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="BorderBrush" Value="#2B3139"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#02A4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkGridViewColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#181A20"/>
            <Setter Property="Foreground" Value="#848E9C"/>
            <Setter Property="BorderBrush" Value="#2B3139"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#252C3B"/>
                                <Setter Property="Foreground" Value="#EAECEF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#2B3139"/>
                                <Setter Property="Foreground" Value="#EAECEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252C3B"/>
                                <Setter Property="Foreground" Value="#EAECEF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2B3139"/>
                                <Setter Property="Foreground" Value="#EAECEF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252C3B"/>
                                <Setter Property="Foreground" Value="#EAECEF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkHorizontalGridSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Height" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#2B3139"/>
            <Setter Property="ResizeDirection" Value="Rows"/>
            <Setter Property="ShowsPreview" Value="False"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#474D57"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== ШАПКА ТЕРМИНАЛА ==================== -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSlate}" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="{StaticResource CyanActive}" Margin="0,0,8,0"/>
                    <TextBlock Text="HERMES" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="Black"/>
                    <TextBlock Text=" FUTURES DEMO" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Bottom"/>
                </StackPanel>

                <!-- Статус WebSocket соединения -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0">
                    <Ellipse Width="8" Height="8" Margin="0,2,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource BearishRed}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WsStatus}" Value="Подключено">
                                        <Setter Property="Fill" Value="{StaticResource BullishGreen}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WsStatus}" Value="Подключение...">
                                        <Setter Property="Fill" Value="Orange"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding WsStatus}" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>

                <!-- Кнопки настроек и журнала -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Настройки" Style="{StaticResource SecondaryBtnStyle}" Command="{Binding OpenSettingsCommand}"
                            Width="95" Height="28" FontSize="11" FontWeight="Bold" Margin="0,0,8,0"/>
                    <Button Content="Журнал" Style="{StaticResource SecondaryBtnStyle}" Command="{Binding OpenLogsCommand}"
                            Width="85" Height="28" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ОСНОВНАЯ ПАНЕЛЬ (Binance-style) ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="220" MinHeight="80"/>
            </Grid.RowDefinitions>

            <!-- LЕВАЯ: ВЫБОР ТОРГОВЫХ ПАР -->
            <Border Grid.Column="0" Grid.RowSpan="3" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderSlate}" BorderThickness="0,0,1,0">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Поле поиска -->
                    <TextBox Grid.Row="0" Height="26" Margin="0,0,0,10" Style="{StaticResource DarkTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Список торговых пар -->
                    <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" ItemsSource="{Binding FilteredSymbols}"
                             SelectedItem="{Binding SelectedSymbol}" Foreground="{StaticResource TextMain}" SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="3">
                                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#1E222B"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#252C3B"/>
                                                    <Setter Property="Foreground" Value="{StaticResource CyanActive}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="12"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ЦЕНТР: ТИКЕР + ГРАФИК -->
            <Grid Grid.Column="1" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Статистика тикера -->
                <Border Grid.Row="0" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderSlate}" BorderThickness="0,0,0,1">
                    <Grid Margin="15,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Символ и цена -->
                        <TextBlock Grid.Column="0" Text="{Binding SelectedSymbol}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,15,0"/>
                        
                        <TextBlock Grid.Column="1" Text="{Binding Ticker.PriceDisplay, FallbackValue='0.00'}" FontSize="15" FontWeight="Bold" Margin="0,0,25,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Ticker.IsPositive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BullishGreen}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Ticker.IsPositive}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource BearishRed}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Параметры -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,20,0">
                            <TextBlock Text="24ч Изм: " FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding Ticker.PercentDisplay, FallbackValue='0.00%'}" FontSize="10" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Ticker.IsPositive}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BullishGreen}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Ticker.IsPositive}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource BearishRed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,20,0">
                            <TextBlock Text="24ч Макс: " FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding Ticker.HighPrice, StringFormat='N4', FallbackValue='0.00'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="5" Orientation="Horizontal">
                            <TextBlock Text="24ч Мин: " FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding Ticker.LowPrice, StringFormat='N4', FallbackValue='0.00'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Таймфрейм графика -->
                <Border Grid.Row="1" Background="#14171C" BorderBrush="{StaticResource BorderSlate}" BorderThickness="0,0,0,1" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Интервал" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ListBox ItemsSource="{Binding ChartIntervals}"
                                 SelectedIndex="{Binding SelectedChartIntervalIndex}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                    <Setter Property="Foreground" Value="#848E9C"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Chip" Background="#252930" CornerRadius="3" Padding="10,4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Chip" Property="Background" Value="#383f49"/>
                                                        <Setter Property="Foreground" Value="#EAECEF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chip" Property="Background" Value="#383f49"/>
                                                        <Setter Property="Foreground" Value="#EAECEF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Кастомный график свечей -->
                <ctrl:CandlestickChart Grid.Row="2" Candles="{Binding Candles}" LastPrice="{Binding Ticker.LastPrice, FallbackValue=0}" Margin="0"/>
            </Grid>

            <!-- ПРАВАЯ-ЦЕНТР: СТАКАН И СДЕЛКИ -->
            <Border Grid.Column="2" Grid.Row="0" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderSlate}" BorderThickness="1,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Стакан ордеров (Книга) -->
                        <RowDefinition Height="*"/>
                        <!-- Недавние сделки -->
                        <RowDefinition Height="220"/>
                    </Grid.RowDefinitions>

                    <!-- СТАКАН ОРДЕРОВ -->
                    <Grid Grid.Row="0" Margin="10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="БИРЖЕВОЙ СТАКАН" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,5"/>

                        <!-- Заголовки колонок стакана -->
                        <Grid Grid.Row="1" Height="16" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Цена" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Grid.Column="1" Text="Размер" FontSize="9.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="Всего" FontSize="9.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Списки Асков и Билиов в общем стеке -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <!-- Аски (Продажи - красные) -->
                                <RowDefinition Height="*"/>
                                <!-- Спред -->
                                <RowDefinition Height="26"/>
                                <!-- Биды (Покупки - зеленые) -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Аски -->
                            <ItemsControl Grid.Row="0" ItemsSource="{Binding Asks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent" Height="17">
                                            <!-- Визуальный бар заполнения стакана -->
                                            <Border Background="#15F6465D" HorizontalAlignment="Right" Width="{Binding Percentage}" Height="16" Opacity="0.5"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PriceDisplay}" Foreground="{StaticResource BearishRed}" FontSize="10.5" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}" Foreground="{StaticResource TextMain}" FontSize="10" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TotalDisplay}" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Разделитель: Спред -->
                            <Border Grid.Row="1" Background="#181A20" BorderBrush="{StaticResource BorderSlate}" BorderThickness="0,1" VerticalAlignment="Center" Height="22">
                                <TextBlock Text="{Binding SpreadDisplay}" Foreground="{StaticResource CyanActive}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Биды -->
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Bids}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent" Height="17">
                                            <!-- Визуальный бар заполнения стакана -->
                                            <Border Background="#150ECB81" HorizontalAlignment="Right" Width="{Binding Percentage}" Height="16" Opacity="0.5"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PriceDisplay}" Foreground="{StaticResource BullishGreen}" FontSize="10.5" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}" Foreground="{StaticResource TextMain}" FontSize="10" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TotalDisplay}" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>

                    <!-- НЕДАВНИЕ СДЕЛКИ -->
                    <Border Grid.Row="1" Margin="10,5" BorderBrush="{StaticResource BorderSlate}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="СДЕЛКИ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,8,0,5"/>

                        <Grid Grid.Row="1" Height="16" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Время" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Grid.Column="1" Text="Цена" FontSize="9.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="Кол-во" FontSize="9.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                        </Grid>

                        <ListBox Grid.Row="2" Background="Transparent" BorderThickness="0" ItemsSource="{Binding RecentTrades}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeDisplay}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PriceDisplay}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BullishGreen}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBuy}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource BearishRed}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding AmountDisplay}" Foreground="{StaticResource TextMain}" FontSize="10" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                </Grid>
            </Border>

            <!-- Разделитель: график/стакан ↔ нижняя панель (не затрагивает правую колонку) -->
            <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                          Style="{StaticResource DarkHorizontalGridSplitterStyle}"/>

            <!-- НИЖНЯЯ ПАНЕЛЬ: ПОЗИЦИИ / ОРДЕРА (под графиком и стаканом) -->
            <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSlate}" BorderThickness="0,1,0,0">
            <TabControl Background="Transparent" BorderThickness="0" Margin="10,5">
                <TabControl.Resources>
                    <!-- Кастомная стилизация вкладок в темную тему -->
                    <Style TargetType="TabItem">
                        <Setter Property="Header" Value="{Binding Header}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#848E9C"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="Padding" Value="15,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderSlate}" BorderThickness="0,0,0,2" Margin="0,0,10,0">
                                        <ContentPresenter x:Name="ContentSite" ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CyanActive}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#EAECEF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- ВКЛАДКА: АКТИВЫ -->
                <TabItem Header="{Binding BalancesTabHeader}">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="Обновить кошелек" Style="{StaticResource SecondaryBtnStyle}" Command="{Binding RefreshBalancesCommand}" HorizontalAlignment="Left" Width="135" Height="22" FontSize="10" Margin="0,0,0,5"/>

                        <ListView Grid.Row="1" Background="Transparent" BorderThickness="0" ItemsSource="{Binding Balances}" Foreground="{StaticResource TextMain}">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeaderStyle}">
                                    <GridViewColumn Header="Актив" Width="100" DisplayMemberBinding="{Binding Asset}"/>
                                    <GridViewColumn Header="Доступно" Width="160" DisplayMemberBinding="{Binding FreeDisplay}"/>
                                    <GridViewColumn Header="В ордерах" Width="160" DisplayMemberBinding="{Binding LockedDisplay}"/>
                                    <GridViewColumn Header="Всего" Width="160" DisplayMemberBinding="{Binding TotalDisplay}"/>
                                </GridView>
                            </ListView.View>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DarkListViewItemStyle}">
                                    <Setter Property="Height" Value="24"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </TabItem>

                <TabItem Header="{Binding PositionsTabHeader}">
                    <ctrl:PositionsPanel DataContext="{Binding}"/>
                </TabItem>

                <TabItem Header="{Binding OpenOrdersTabHeader}">
                    <Grid Margin="0,8,0,0">
                        <ListView Background="Transparent" BorderThickness="0" ItemsSource="{Binding OpenOrders}" Foreground="{StaticResource TextMain}">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeaderStyle}">
                                    <GridViewColumn Header="Время" Width="130" DisplayMemberBinding="{Binding TimeDisplay}"/>
                                    <GridViewColumn Header="Пара" Width="80" DisplayMemberBinding="{Binding Symbol}"/>
                                    <GridViewColumn Header="Направление" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SideDisplay}" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BullishGreen}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBuy}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource BearishRed}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Тип" Width="80" DisplayMemberBinding="{Binding Type}"/>
                                    <GridViewColumn Header="Цена" Width="100" DisplayMemberBinding="{Binding PriceDisplay}"/>
                                    <GridViewColumn Header="Количество" Width="100" DisplayMemberBinding="{Binding AmountDisplay}"/>
                                    <GridViewColumn Header="Исполнено" Width="100" DisplayMemberBinding="{Binding ExecutedDisplay}"/>
                                    <GridViewColumn Header="Статус" Width="100" DisplayMemberBinding="{Binding Status}"/>
                                    <GridViewColumn Header="Действие" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Отменить" FontSize="9.5" Background="#2B3139" Foreground="#F6465D" FontWeight="Bold" BorderThickness="0" Padding="6,2" Height="18"
                                                        Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DarkListViewItemStyle}">
                                    <Setter Property="Height" Value="25"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </TabItem>

                <TabItem Header="ИСТОРИЯ ОРДЕРОВ">
                    <Grid Margin="0,8,0,0">
                        <ListView Background="Transparent" BorderThickness="0" ItemsSource="{Binding OrderHistory}" Foreground="{StaticResource TextMain}">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeaderStyle}">
                                    <GridViewColumn Header="ID Ордера" Width="100" DisplayMemberBinding="{Binding OrderId}"/>
                                    <GridViewColumn Header="Время" Width="130" DisplayMemberBinding="{Binding TimeDisplay}"/>
                                    <GridViewColumn Header="Пара" Width="80" DisplayMemberBinding="{Binding Symbol}"/>
                                    <GridViewColumn Header="Направление" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SideDisplay}" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BullishGreen}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBuy}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource BearishRed}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Тип" Width="80" DisplayMemberBinding="{Binding Type}"/>
                                    <GridViewColumn Header="Цена" Width="100" DisplayMemberBinding="{Binding PriceDisplay}"/>
                                    <GridViewColumn Header="Количество" Width="100" DisplayMemberBinding="{Binding AmountDisplay}"/>
                                    <GridViewColumn Header="Исполнено" Width="100" DisplayMemberBinding="{Binding ExecutedDisplay}"/>
                                    <GridViewColumn Header="Статус" Width="110" DisplayMemberBinding="{Binding Status}"/>
                                </GridView>
                            </ListView.View>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DarkListViewItemStyle}">
                                    <Setter Property="Height" Value="25"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- ВКЛАДКА: ИСТОРИЯ СДЕЛОК -->
                <TabItem Header="{Binding TradeHistoryTabHeader}">
                    <ctrl:TradeHistoryPanel DataContext="{Binding}"/>
                </TabItem>
            </TabControl>
            </Border>

            <!-- ПРАВАЯ КОЛОНКА: ОРДЕР + ИТОГИ + АККАУНТ -->
            <Grid Grid.Column="3" Grid.Row="0" Grid.RowSpan="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

            <!-- ФОРМА ОРДЕРА -->
            <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSlate}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                    <StackPanel Margin="12,10">
                        <TextBlock Text="ОРДЕР" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,10"/>

                        <!-- Кросс / Плечо -->
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Content="{Binding MarginModeDisplay}" Style="{StaticResource LeverageChipBtnStyle}"
                                    Margin="0,0,4,0" Command="{Binding OpenAdjustMarginModeCommand}"
                                    ToolTip="Изменить режим маржи"/>
                            <Button Content="{Binding LeverageDisplay}" Style="{StaticResource LeverageChipBtnStyle}"
                                    Margin="4,0,0,0" Command="{Binding OpenAdjustLeverageCommand}"
                                    ToolTip="Изменить кредитное плечо"/>
                        </UniformGrid>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Дост." FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextMain}" VerticalAlignment="Center">
                                <Run Text="{Binding UsdtAvailableDisplay, Mode=OneWay}"/>
                                <Run Text=" USDT" Foreground="{StaticResource TextMuted}"/>
                            </TextBlock>
                        </Grid>

                        <!-- Лимит / Рынок / Условные -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton GroupName="OrderType" Content="Лимит" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold"
                                         IsChecked="{Binding IsLimitOrderEntry}" Margin="0,0,12,0" Padding="0,4"/>
                            <RadioButton GroupName="OrderType" Content="Рынок" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold"
                                         IsChecked="{Binding IsMarketOrderEntry}" Margin="0,0,12,0" Padding="0,4"/>
                            <RadioButton GroupName="OrderType" Content="Условные" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold"
                                         IsChecked="{Binding IsConditionalOrderEntry}" Padding="0,4"/>
                        </StackPanel>

                        <!-- Стоп-цена (условные) -->
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConditionalOrder}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Стоп-цена" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <Button x:Name="ConditionalInfoBtn" Content="ℹ" Command="{Binding ToggleConditionalInfoCommand}" Width="18" Height="18" Margin="4,0,0,0"
                                        FontSize="10" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                            <TextBox FontSize="11.5" Style="{StaticResource DarkTextBoxStyle}" Height="30"
                                     Text="{Binding OrderStopPrice, UpdateSourceTrigger=PropertyChanged}"/>
                            <Popup IsOpen="{Binding IsConditionalInfoOpen}" StaysOpen="False" AllowsTransparency="True"
                                   PlacementTarget="{Binding ElementName=ConditionalInfoBtn}" Placement="Bottom" VerticalOffset="4">
                                <Border Background="#181A20" BorderBrush="#2B3139" BorderThickness="1" CornerRadius="6"
                                        Padding="10" MaxWidth="280">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ConditionalOrderInfo}" Foreground="{StaticResource TextMain}"
                                                   FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <Button Content="Подробнее" Style="{StaticResource DarkLinkBtnStyle}"
                                                Command="{Binding OpenConditionalInfoLinkCommand}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>

                        <!-- Цена (лимит / условный лимит) -->
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsConditionalOrder}" Value="True"/>
                                                <Condition Binding="{Binding IsConditionalMarket}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Цена" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                            <Grid Height="30">
                                <TextBox FontSize="11.5" Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding OrderPrice, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsLimitOrder}"/>
                                <TextBlock Text="РЫНОЧНАЯ" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMarketOrder}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- Параметры условного ордера -->
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConditionalOrder}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Исполнение после триггера" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                            <ComboBox SelectedIndex="{Binding ConditionalExecutionModeIndex}" FontSize="11" Height="28" Margin="0,0,0,6">
                                <ComboBoxItem Content="Лимитный"/>
                                <ComboBoxItem Content="Рыночный"/>
                            </ComboBox>
                            <TextBlock Text="Working type" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                            <ComboBox SelectedIndex="{Binding StopWorkingTypeIndex}" FontSize="11" Height="28" Margin="0,0,0,6">
                                <ComboBoxItem Content="Contract price"/>
                                <ComboBoxItem Content="Mark price"/>
                            </ComboBox>
                            <CheckBox Content="Reduce only" Foreground="{StaticResource TextMain}" FontSize="10"
                                      IsChecked="{Binding OrderReduceOnly}" Margin="0,0,0,6"/>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConditionalLimit}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Time in force" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                <ComboBox SelectedIndex="{Binding OrderTimeInForceIndex}" FontSize="11" Height="28">
                                    <ComboBoxItem Content="GTC"/>
                                    <ComboBoxItem Content="IOC"/>
                                    <ComboBoxItem Content="FOK"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- Количество -->
                        <TextBlock Text="{Binding QuantityLabel}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <Grid Height="30" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" FontSize="11.5" Style="{StaticResource DarkTextBoxStyle}"
                                     Text="{Binding OrderQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="1,1,0,1"/>
                            <ctrl:QuantityUnitSelector Grid.Column="1"/>
                        </Grid>
                        <TextBlock Text="{Binding QuantityHint}" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding ContractQtyPreview}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>

                        <!-- Проценты -->
                        <UniformGrid Columns="4" Margin="0,0,0,8">
                            <Button Content="25%" Command="{Binding SetPercentageQtyCommand}" CommandParameter="25%" Style="{StaticResource PctBtnStyle}" Margin="0,0,2,0"/>
                            <Button Content="50%" Command="{Binding SetPercentageQtyCommand}" CommandParameter="50%" Style="{StaticResource PctBtnStyle}" Margin="0,0,2,0"/>
                            <Button Content="75%" Command="{Binding SetPercentageQtyCommand}" CommandParameter="75%" Style="{StaticResource PctBtnStyle}" Margin="0,0,2,0"/>
                            <Button Content="100%" Command="{Binding SetPercentageQtyCommand}" CommandParameter="100%" Style="{StaticResource PctBtnStyle}"/>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <TextBlock Text="Всего: " FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalCost, StringFormat='N2'}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                            <TextBlock Text=" USDT" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- TP/SL -->
                        <CheckBox Content="TP/SL" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold"
                                  IsChecked="{Binding UseOrderSlTp}" Margin="0,0,0,8"/>

                        <StackPanel Margin="0,0,0,10">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UseOrderSlTp}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Stop-Loss" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                            <TextBox Height="28" FontSize="11.5" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,8"
                                     Text="{Binding OrderStopLoss, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Take-Profit" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                            <TextBox Height="28" FontSize="11.5" Style="{StaticResource DarkTextBoxStyle}"
                                     Text="{Binding OrderTakeProfit, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <Button Content="Купить / Long" Style="{StaticResource BuyBtnStyle}" Command="{Binding PlaceBuyOrderCommand}" Height="36" Margin="0,0,0,8"/>
                        <Button Content="Продать / Short" Style="{StaticResource SellBtnStyle}" Command="{Binding PlaceSellOrderCommand}" Height="36"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ИТОГИ PnL / КОМИССИИ -->
            <Border Grid.Row="1" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderSlate}"
                    BorderThickness="1,0,0,0" Padding="12,8">
                <ctrl:TradeStatsSummaryPanel DataContext="{Binding}" VerticalAlignment="Top"/>
            </Border>

            <!-- АККАУНТ (под формой ордера) -->
            <Border Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSlate}" BorderThickness="1,1,0,0">
                <StackPanel Margin="12,10">
                    <TextBlock Text="АККАУНТ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Доступно USDT" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding UsdtAvailableDisplay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Баланс кошелька" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding UsdtWalletDisplay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                    </Grid>
                    <Button Content="Обновить" Style="{StaticResource SecondaryBtnStyle}" Command="{Binding RefreshBalancesCommand}"
                            HorizontalAlignment="Stretch" Height="28" FontSize="10"/>
                </StackPanel>
            </Border>
            </Grid>
        </Grid>
    </Grid>
