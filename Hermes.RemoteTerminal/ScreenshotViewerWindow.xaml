<Window x:Class="Hermes.RemoteTerminal.ScreenshotViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HWT Screenshot"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        WindowStartupLocation="Manual"
        Topmost="True"
        Background="#000000"
        ShowInTaskbar="True"
        Focusable="True"
        Loaded="Window_OnLoaded"
        Closed="Window_OnClosed"
        PreviewKeyDown="Window_OnKeyDown"
        KeyDown="Window_OnKeyDown"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <Grid>
        <Image x:Name="imgView"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>
        <Border x:Name="blankOverlay"
                Background="#000000"
                Visibility="Collapsed"
                Panel.ZIndex="10"/>
        <!-- Hidden while asleep so black blank is uninterrupted -->
        <DockPanel x:Name="chromeBar"
                   Margin="16"
                   VerticalAlignment="Bottom"
                   Panel.ZIndex="20">
            <Button x:Name="btnClose"
                    DockPanel.Dock="Right"
                    Content="Закрыть (Esc)"
                    Padding="16,8"
                    Background="#2B3139"
                    Foreground="#EAECEF"
                    BorderBrush="#848E9C"
                    Cursor="Hand"
                    Click="Close_OnClick"/>
            <TextBlock x:Name="txtCountdown"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#F0B90B"/>
            <TextBlock x:Name="txtPath"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       FontSize="12"
                       Foreground="#848E9C"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
