<Window x:Class="Hermes.EnglishTutorClient.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лог — English Tutor Client"
        Width="720" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="#0B0E11" Foreground="#EAECEF"
        Loaded="Window_OnLoaded"
        Closed="Window_OnClosed">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource DarkBtn}" Content="Обновить" Click="Refresh_OnClick" Margin="0"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource DarkBtn}" Content="Очистить"
                    Click="Clear_OnClick" ToolTip="Очистить окно и файл app.log"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource DarkBtn}" Content="Папка…" Click="Folder_OnClick"/>
            <TextBlock x:Name="PathText" Foreground="#848E9C" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <TextBox x:Name="LogBox" Grid.Row="1"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Background="#161B22" Foreground="#EAECEF"
                 BorderBrush="#2B3139" CaretBrush="#EAECEF"/>
        <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="#848E9C"
                   Text="Папка логов задаётся в Настройки → Логи. «Очистить» стирает окно и файл."/>
    </Grid>
</Window>
