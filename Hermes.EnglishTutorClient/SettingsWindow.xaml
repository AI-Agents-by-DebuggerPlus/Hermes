<Window x:Class="Hermes.EnglishTutorClient.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — English Tutor Client"
        Width="640" Height="580"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#0B0E11" Foreground="#EAECEF">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAECEF"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAECEF"/></Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#EAECEF"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="BorderBrush" Value="#2B3139"/>
            <Setter Property="CaretBrush" Value="#EAECEF"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="Background" Value="#181A20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="#181A20" BorderBrush="#2B3139" BorderThickness="1"
                                Padding="12,6" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B3139"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F0B90B"/>
                                <Setter Property="Foreground" Value="#F8D12F"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383f49"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383f49"/>
                                <Setter Property="Foreground" Value="#F8D12F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="BorderBrush" Value="#2B3139"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#161B22" BorderBrush="#2B3139" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="Transparent"/>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0" Stroke="#EAECEF" StrokeThickness="1.5"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="8,4,28,4" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                                <Border Background="#2B3139" BorderBrush="#848E9C" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="#0B0E11" BorderThickness="0">
            <TabItem Header="Шрифты">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Репетитор (pt)" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="TutorFontBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="Пользователь (pt)" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="UserFontBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Text="Вопрос (pt)" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="QuestionFontBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Text="Слова (pt)" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="WordsFontBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="4" Text="Цвет репетитора" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="TutorColorBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="5" Text="Цвет пользователя" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="UserColorBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="6" Text="Цвет вопроса" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="QuestionColorBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="7" Text="Цвет слов" VerticalAlignment="Center"/>
                        <TextBox x:Name="WordsColorBox" Grid.Row="7" Grid.Column="1"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Голоса">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <TextBlock Text="Провайдер" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="AzureRadio" Content="Azure Neural" Margin="0,0,16,0" GroupName="Tts"/>
                            <RadioButton x:Name="SapiRadio" Content="SAPI (локально)" GroupName="Tts"/>
                        </StackPanel>
                        <TextBlock Text="SAPI EN" Margin="0,0,0,4"/>
                        <ComboBox x:Name="EnVoiceBox" DisplayMemberPath="Name" Margin="0,0,0,8"
                                  SelectionChanged="SapiVoice_OnChanged"/>
                        <TextBlock Text="SAPI RU" Margin="0,0,0,4"/>
                        <ComboBox x:Name="RuVoiceBox" DisplayMemberPath="Name" Margin="0,0,0,12"
                                  SelectionChanged="SapiVoice_OnChanged"/>
                        <TextBlock Text="Azure key (только TTS)" Margin="0,0,0,4" Foreground="#848E9C"/>
                        <TextBox x:Name="AzureKeyBox" Margin="0,0,0,8"/>
                        <TextBlock Text="Azure endpoint" Margin="0,0,0,4"/>
                        <TextBox x:Name="AzureEndpointBox" Margin="0,0,0,8"/>
                        <TextBlock Text="Azure region (если нет endpoint)" Margin="0,0,0,4"/>
                        <TextBox x:Name="AzureRegionBox" Margin="0,0,0,8"/>
                        <TextBlock Text="Google Speech API key (STT)" Margin="0,12,0,4" Foreground="#848E9C"/>
                        <TextBox x:Name="GoogleSttKeyBox" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#848E9C"
                                  Text="STT: Google API key → Google Speech; иначе Azure key → Azure STT; иначе локальный SAPI."/>
                        <Button Style="{StaticResource DarkBtn}" Content="Обновить список Azure" Click="RefreshAzureVoices_OnClick" Margin="0,0,0,8"/>
                        <TextBlock Text="Azure EN" Margin="0,0,0,4"/>
                        <ComboBox x:Name="AzureEnBox" DisplayMemberPath="Name" Margin="0,0,0,8"
                                  SelectionChanged="AzureVoice_OnChanged"/>
                        <TextBlock Text="Azure RU" Margin="0,0,0,4"/>
                        <ComboBox x:Name="AzureRuBox" DisplayMemberPath="Name" Margin="0,0,0,8"
                                  SelectionChanged="AzureVoice_OnChanged"/>
                        <TextBlock Text="Громкость %" Margin="0,0,0,4"/>
                        <TextBox x:Name="VolumeBox" Margin="0,0,0,8"/>
                        <CheckBox x:Name="AutoSpeakBox" Content="Автоозвучка"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Supabase">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <CheckBox x:Name="PreferRemoteBox" Content="Remote при доступном Supabase (иначе local demo)" Margin="0,0,0,12"/>
                        <TextBlock Text="URL" Margin="0,0,0,4"/>
                        <TextBox x:Name="SbUrlBox" Margin="0,0,0,8"/>
                        <TextBlock Text="Anon key" Margin="0,0,0,4"/>
                        <TextBox x:Name="SbKeyBox" Margin="0,0,0,8"/>
                        <TextBlock Text="Имя клиента (sender_name / inbound recipient)" Margin="0,0,0,4"/>
                        <TextBox x:Name="RecipientBox" Margin="0,0,0,8"/>
                        <TextBlock Text="Кому слать (Hermes)" Margin="0,0,0,4"/>
                        <TextBox x:Name="HermesRecipientBox" Margin="0,0,0,8"/>
                        <TextBlock Text="Фильтр sender (Hermes)" Margin="0,0,0,4"/>
                        <TextBox x:Name="SenderFilterBox" Margin="0,0,0,8"/>
                        <TextBlock Text="Poll, сек" Margin="0,0,0,4"/>
                        <TextBox x:Name="PollBox"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Горячие клавиши">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#848E9C" Margin="0,0,0,12"
                                   Text="Часть уже работает; пустое значение — заготовка (не реализована)."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Полный экран" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="HkFullscreen" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" IsReadOnly="True"/>
                            <TextBlock Grid.Row="1" Text="Отправить" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="HkSend" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" IsReadOnly="True"/>
                            <TextBlock Grid.Row="2" Text="Новая строка" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="HkNewline" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" IsReadOnly="True"/>
                            <TextBlock Grid.Row="3" Text="Озвучить" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="HkSpeak" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="4" Text="Старт теста" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="HkStart" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="5" Text="Стоп TTS / выход из FS" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="HkStop" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="6" Text="Настройки" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="HkSettings" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="7" Text="Лог" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="HkLog" Grid.Row="7" Grid.Column="1" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="8" Text="Фокус ввода" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="HkFocus" Grid.Row="8" Grid.Column="1" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="9" Text="Очистить чат (заготовка)" VerticalAlignment="Center"/>
                            <TextBox x:Name="HkClear" Grid.Row="9" Grid.Column="1"/>
                        </Grid>
                        <TextBlock Margin="0,16,0,0" Foreground="#848E9C" TextWrapping="Wrap"
                                   Text="Гарнитура Play/Pause: старт/стоп голосового ввода (MediaPlayPause)."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Логи">
                <StackPanel Margin="8">
                    <TextBlock Text="Папка логов" Margin="0,0,0,6"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DarkBtn}" Content="…" Width="40"
                                Click="BrowseLogFolder_OnClick" Margin="8,0,0,0"/>
                        <TextBox x:Name="LogFolderBox"/>
                    </DockPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource DarkBtn}" Content="Сохранить" Width="110" Click="Save_OnClick"/>
            <Button Style="{StaticResource DarkBtn}" Content="Отмена" Width="100" Click="Cancel_OnClick" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
