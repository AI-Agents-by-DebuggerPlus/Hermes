<Window x:Class="HibernateCountdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hibernate"
        Width="420" Height="220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#0B0E11"
        Foreground="#EAECEF"
        FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Переход в гибернацию"
               FontSize="20" FontWeight="SemiBold" Foreground="#F8D12F"/>
    <TextBlock x:Name="CountdownText"
               Grid.Row="1"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               FontSize="48"
               FontWeight="Bold"
               Foreground="#EAECEF"
               Text="10"/>
    <Button Grid.Row="2"
            Content="Cancel"
            Height="40"
            FontSize="16"
            Cursor="Hand"
            Click="Cancel_Click">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="#2B3139"
                  BorderBrush="#F85149"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="12,0">
            <ContentPresenter x:Name="Cp"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="#FFFFFF"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#3D1F24"/>
              <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#5A1520"/>
              <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="#1A1D24"/>
              <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#848E9C"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
    </Button>
  </Grid>
</Window>
