<Window x:Class="Hermes.SpotTerminal.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes Spot Terminal"
        Width="1100" Height="700"
        Background="#0D1117">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="HERMES SPOT" Foreground="#58A6FF" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding FeedStatus}" Foreground="#3FB950" Margin="24,4,0,0" />
            <TextBlock Text="{Binding ExecutionModeLabel}" Foreground="#8B949E" Margin="16,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Virtual" Click="OnVirtual" Margin="0,0,8,0" Padding="12,6" />
            <Button Content="Spot Demo" Click="OnSpotDemo" Margin="0,0,8,0" Padding="12,6" />
            <Button Content="Agent Thought" Click="OnAgentThought" Margin="0,0,8,0" Padding="12,6" />
            <Button Content="Backtest Skill" Click="OnBacktest" Padding="12,6" />
            <Button Content="Logs: All" Click="OnLogsAll" Margin="16,0,4,0" Padding="8,6" />
            <Button Content="Logs: Agent" Click="OnLogsAgent" Padding="8,6" />
        </StackPanel>

        <GroupBox Grid.Row="2" Header="Тест позиций (market)" Foreground="White" Margin="0,0,0,12">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Символ" Foreground="#C9D1D9" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TestSymbolCombo" IsEditable="True"
                          Background="#161B22" Foreground="White" BorderBrush="#30363D" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Объём" Foreground="#C9D1D9" VerticalAlignment="Center" Margin="16,0,10,0" />
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="TestQtyTextBox" Text="0.01"
                         Background="#161B22" Foreground="White" BorderBrush="#30363D" />

                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Content="Long ▲" Click="OnTestLong" Padding="14,6" Margin="0,0,8,0"
                            Background="#238636" Foreground="White" BorderBrush="#2EA043" />
                    <Button Content="Short ▼" Click="OnTestShort" Padding="14,6"
                            Background="#DA3633" Foreground="White" BorderBrush="#F85149" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Быстро:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="BTC Long" Tag="BTCUSDT|Buy" Click="OnTestQuick" Padding="10,4" Margin="0,0,6,0" />
                    <Button Content="BTC Short" Tag="BTCUSDT|Sell" Click="OnTestQuick" Padding="10,4" Margin="0,0,6,0" />
                    <Button Content="ETH Long" Tag="ETHUSDT|Buy" Click="OnTestQuick" Padding="10,4" Margin="0,0,6,0" />
                    <Button Content="ETH Short" Tag="ETHUSDT|Sell" Click="OnTestQuick" Padding="10,4" Margin="0,0,12,0" />
                    <TextBlock x:Name="TestOrderStatusText" Text="—" Foreground="#8B949E" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                    <TextBlock x:Name="LogFilePathText" Foreground="#6E7681" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" MaxWidth="420" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Binance Spot Demo API" Foreground="White" Margin="0,0,0,12">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="API Key" Foreground="#C9D1D9" Margin="0,2,10,0" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ApiKeyTextBox" Background="#161B22" Foreground="White" BorderBrush="#30363D" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="API Secret" Foreground="#C9D1D9" Margin="16,2,10,0" />
                <PasswordBox Grid.Row="0" Grid.Column="3" x:Name="ApiSecretBox" Background="#161B22" Foreground="White" BorderBrush="#30363D" />

                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,0,0,0">
                    <Button Content="Reload" Click="OnReloadApiSettings" Padding="10,6" Margin="0,0,8,0" />
                    <Button Content="Save" Click="OnSaveApiSettings" Padding="10,6" />
                    <TextBlock Text="(ключи из Binance → Demo Trading → API Management)" Foreground="#8B949E" Margin="12,4,0,0" TextWrapping="Wrap" MaxWidth="320" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                           Text="Demo Mode: demo-api.binance.com (не testnet.binance.vision). Ключи создайте в Demo Trading на binance.com. Файл: %LocalAppData%\\HermesSpot\\platform-settings.json"
                           Foreground="#8B949E" Margin="0,10,0,0" TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Balances / Tickers" Foreground="White" Grid.Column="0" Margin="0,0,8,0">
                <StackPanel>
                    <ListView ItemsSource="{Binding Balances}" Height="120" Background="#161B22" Foreground="White">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Asset" DisplayMemberBinding="{Binding Asset}" Width="60" />
                                <GridViewColumn Header="Free" DisplayMemberBinding="{Binding Free}" Width="80" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <ListView ItemsSource="{Binding Tickers}" Background="#161B22" Foreground="White">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Symbol" DisplayMemberBinding="{Binding Symbol}" Width="80" />
                                <GridViewColumn Header="Price" DisplayMemberBinding="{Binding Price}" Width="100" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Orders / Skills" Foreground="White" Grid.Column="1" Margin="0,0,8,0">
                <StackPanel>
                    <ListView ItemsSource="{Binding Orders}" Height="140" Background="#161B22" Foreground="White">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="60" />
                                <GridViewColumn Header="Symbol" DisplayMemberBinding="{Binding Symbol}" Width="70" />
                                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="70" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <ListView ItemsSource="{Binding Skills}" Background="#161B22" Foreground="White">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="120" />
                                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="80" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Logs" Foreground="White" Grid.Column="2">
                <ListView ItemsSource="{Binding Logs}" Background="#161B22" Foreground="White">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Src" DisplayMemberBinding="{Binding Source}" Width="60" />
                            <GridViewColumn Header="Type" DisplayMemberBinding="{Binding EventType}" Width="100" />
                            <GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" Width="280" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
