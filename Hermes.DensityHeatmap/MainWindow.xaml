<Window x:Class="Hermes.DensityHeatmap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes Density Heatmap"
        Width="920" Height="640"
        MinWidth="700" MinHeight="480"
        Background="#0B0E11"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Density Heatmap"
                   FontSize="18" FontWeight="SemiBold" Foreground="#F8D12F"/>
        <TextBlock x:Name="MetaLabel" Foreground="#848E9C" FontSize="12" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Refresh" Padding="12,6" Margin="0,0,8,0"
                Background="#2B3139" Foreground="#EAECEF" BorderBrush="#383f49"
                Click="Refresh_Click"/>
        <Button Content="Start screener (Spot)" Padding="12,6" Margin="0,0,8,0"
                Background="#2B3139" Foreground="#EAECEF" BorderBrush="#383f49"
                Click="StartSpot_Click"/>
        <Button Content="Start screener (Futures Demo)" Padding="12,6"
                Background="#2B3139" Foreground="#EAECEF" BorderBrush="#383f49"
                Click="StartFutures_Click"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#181A20" BorderBrush="#2B3139"
              BorderThickness="1" CornerRadius="8" Margin="0,0,8,0" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Price ladder (strength heatmap)"
                     Foreground="#848E9C" Margin="0,0,0,8"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="LadderList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2" Height="22">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PriceText}"
                               Foreground="#EAECEF" VerticalAlignment="Center" FontFamily="Consolas"/>
                    <Border Grid.Column="1" CornerRadius="3" Margin="4,2"
                            Background="{Binding BarBrush}"
                            HorizontalAlignment="Left"
                            Width="{Binding BarWidth}"
                            Height="16"/>
                    <TextBlock Grid.Column="2" Text="{Binding MetaText}"
                               Foreground="#848E9C" FontSize="11"
                               VerticalAlignment="Center" FontFamily="Consolas"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="#181A20" BorderBrush="#2B3139"
              BorderThickness="1" CornerRadius="8" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Near mid / alerts"
                     Foreground="#848E9C" Margin="0,0,0,8"/>
          <ListBox x:Name="AlertList"
                   Background="Transparent" BorderThickness="0"
                   Foreground="#EAECEF"/>
        </DockPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" x:Name="StatusLabel" Margin="0,10,0,0"
               Foreground="#848E9C" FontSize="11"/>
  </Grid>
</Window>
