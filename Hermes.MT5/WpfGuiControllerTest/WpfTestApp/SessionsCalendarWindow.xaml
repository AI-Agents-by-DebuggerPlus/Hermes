<Window x:Class="WpfTestApp.SessionsCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trading Sessions (Pacific Time, UTC−8)"
        Height="420" Width="520"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#0B0E11">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="FX sessions · British Columbia (UTC−8)"
                   FontSize="14" FontWeight="SemiBold" Foreground="#F0B90B" Margin="0,0,0,10"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="txtCalendar" FontFamily="Consolas" FontSize="12"
                       Foreground="#EAECEF" TextWrapping="Wrap"/>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="11" Foreground="#848E9C"
                   Text="Times are approximate major-session hours. Broker quote sessions may differ."/>
    </Grid>
</Window>
