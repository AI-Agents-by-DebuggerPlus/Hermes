<Window x:Class="WpfTestApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings v29"
        Height="320" Width="420"
        MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterOwner" Topmost="True"
        Background="#0B0E11"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DarkBtn" TargetType="Button">
            <Setter Property="Background" Value="#2B3139"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="BorderBrush" Value="#848E9C"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383f49"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F0B90B"/>
                                <Setter Property="Foreground" Value="#F8D12F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252C3B"/>
                                <Setter Property="Foreground" Value="#EAECEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="txtSettingsHeading" Text="SETTINGS" FontSize="12" FontWeight="SemiBold"
                   Foreground="#F0B90B" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="#181A20" BorderBrush="#2B3139" BorderThickness="1"
                    Padding="14" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Trading" FontSize="11" Foreground="#848E9C" Margin="0,0,0,10"/>
                    <CheckBox x:Name="chkAutoTrade" Content="Auto-trade"/>
                    <CheckBox x:Name="chkRealTrade" Foreground="#F0B90B">
                        <TextBlock Text="Real trading (test)" TextWrapping="Wrap" Foreground="#F0B90B"/>
                    </CheckBox>
                    <TextBlock Text="Флаги передаются в MQL5 через события GUI. Реальная торговля пока stub."
                               FontSize="11" Foreground="#848E9C" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Button Grid.Row="2" x:Name="btnClose" Content="Close" Style="{StaticResource DarkBtn}"
                HorizontalAlignment="Right" Margin="0,14,0,0" MinWidth="88"/>
    </Grid>
</Window>
