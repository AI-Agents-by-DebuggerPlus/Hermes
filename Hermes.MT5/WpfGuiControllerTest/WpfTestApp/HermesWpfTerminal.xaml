<Window x:Class="WpfTestApp.HermesWpfTerminal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HermesWpfTerminal" Height="720" Width="780"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#0B0E11">
    <Window.Resources>
        <!-- Dark button: light text on dark bg, including hover -->
        <Style x:Key="DarkBtn" TargetType="Button">
            <Setter Property="Background" Value="#2B3139"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="BorderBrush" Value="#848E9C"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Cp"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383f49"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F0B90B"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#F8D12F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252C3B"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#EAECEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource DarkBtn}">
            <Setter Property="Height" Value="32"/>
        </Style>

        <!-- Sell: dark red hover, white/light text -->
        <Style x:Key="SellBtn" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#8E0000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8E0000"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F8D12F"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6A0000"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#EAECEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buy: dark green hover, white/light text -->
        <Style x:Key="BuyBtn" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1B5E20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B5E20"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F8D12F"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0D3B12"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#EAECEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2B3139"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="BorderBrush" Value="#848E9C"/>
            <Setter Property="CaretBrush" Value="#EAECEF"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- Dark ComboBox + dark dropdown popup (no light system chrome) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="Background" Value="#2B3139"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383f49"/>
                                <Setter Property="Foreground" Value="#F8D12F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252C3B"/>
                                <Setter Property="Foreground" Value="#F0B90B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2B3139"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="BorderBrush" Value="#848E9C"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" Background="#2B3139" BorderBrush="#848E9C" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#2B3139"/>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 6 6 L 12 0 Z" Fill="#EAECEF"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="#383f49"/>
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#F0B90B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Margin="8,4,28,4" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="#EAECEF"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#2B3139" BorderBrush="#848E9C" BorderThickness="1">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8D12F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#181A20" BorderBrush="#2B3139" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="ACCOUNT" FontSize="11" Foreground="#848E9C"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="txtAccount" Text="—" Foreground="#EAECEF" FontSize="12" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#181A20" BorderBrush="#2B3139" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnQuickSell" Width="140" Height="40" Margin="0,0,6,0"
                            Style="{StaticResource SellBtn}" FontSize="13" Content="SELL"/>
                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                        <TextBlock Text="Lot" FontSize="10" Foreground="#848E9C" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtLot" Width="64" Text="0.10" TextAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="btnQuickBuy" Width="140" Height="40" Margin="6,0,0,0"
                            Style="{StaticResource BuyBtn}" FontSize="13" Content="BUY"/>
                </StackPanel>
                <Button x:Name="btnSessionsCalendar" DockPanel.Dock="Right" Margin="10,0,0,0"
                        Style="{StaticResource DarkBtn}" Content="Sessions…"
                        Padding="10,8" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#181A20" BorderBrush="#2B3139" BorderThickness="1" Padding="8" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="ORDER TYPE" FontSize="10" Foreground="#848E9C" Margin="0,0,0,8"/>
                        <Button x:Name="btnModeMarket" Style="{StaticResource NavBtn}" Content="Market Execution" Tag="Market"/>
                        <Button x:Name="btnModeLimit" Style="{StaticResource NavBtn}" Content="Limit Order" Tag="Limit"/>
                        <Button x:Name="btnModeStop" Style="{StaticResource NavBtn}" Content="Stop Order" Tag="Stop"/>
                        <Button x:Name="btnModeStopLimit" Style="{StaticResource NavBtn}" Content="Stop Limit" Tag="StopLimit"/>
                        <Separator Margin="0,8" Background="#2B3139"/>
                        <TextBlock x:Name="txtSymbol" Text="—" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#F0B90B" Margin="0,4,0,8" TextWrapping="Wrap"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Bid" FontSize="10" Foreground="#848E9C"/>
                                <TextBlock x:Name="txtBid" Text="0.00000" FontSize="16" FontWeight="Bold" Foreground="#EAECEF"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ask" FontSize="10" Foreground="#848E9C"/>
                                <TextBlock x:Name="txtAsk" Text="0.00000" FontSize="16" FontWeight="Bold" Foreground="#EAECEF"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="chkAutoTrade" Content="Auto-trade"/>
                        <CheckBox x:Name="chkRealTrade" Foreground="#F0B90B">
                            <TextBlock Text="Real trading (test)" TextWrapping="Wrap" Foreground="#F0B90B"/>
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="#181A20" BorderBrush="#2B3139" BorderThickness="1" Padding="10"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch">
                <Grid HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Foreground="#848E9C" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbOrderType" Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                              Margin="0,0,0,6" SelectedIndex="0">
                        <ComboBoxItem Content="Market"/>
                        <ComboBoxItem Content="Buy Limit"/>
                        <ComboBoxItem Content="Sell Limit"/>
                        <ComboBoxItem Content="Buy Stop"/>
                        <ComboBoxItem Content="Sell Stop"/>
                        <ComboBoxItem Content="Buy Stop Limit"/>
                        <ComboBoxItem Content="Sell Stop Limit"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Volume" Foreground="#848E9C" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtVolume" Grid.Row="1" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                             Text="0.10" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Price" Foreground="#848E9C" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtPrice" Grid.Row="2" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                             Text="0.000" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Stop Loss" Foreground="#848E9C" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtSL" Grid.Row="3" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                             Text="0.000" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Take Profit" Foreground="#848E9C" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtTP" Grid.Row="4" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                             Text="0.000" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Fill policy" Foreground="#848E9C" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbFill" Grid.Row="5" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                              Margin="0,0,0,6" SelectedIndex="0">
                        <ComboBoxItem Content="Fill or Kill"/>
                        <ComboBoxItem Content="Immediate or Cancel"/>
                        <ComboBoxItem Content="Return"/>
                    </ComboBox>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Comment" Foreground="#848E9C" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtComment" Grid.Row="6" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                             Text="" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="btnSellMarket" Content="Sell by Market" Width="150" Height="36" Margin="0,0,8,0"
                                Style="{StaticResource SellBtn}"/>
                        <Button x:Name="btnBuyMarket" Content="Buy by Market" Width="150" Height="36" Margin="0,0,8,0"
                                Style="{StaticResource BuyBtn}"/>
                        <Button x:Name="btnPlacePending" Content="Place Order" Width="140" Height="36"
                                Style="{StaticResource DarkBtn}" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#181A20" BorderBrush="#2B3139" BorderThickness="1" Padding="8" Margin="0,0,0,6">
            <TextBlock x:Name="txtMarketStatus" Text="Рынок: —" FontSize="11"
                       Foreground="#F0B90B" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="4" Background="#0B0E11" BorderBrush="#2B3139" BorderThickness="1" Padding="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="LOGS (WPF / MQL5)" FontSize="10"
                           Foreground="#848E9C" Margin="0,0,0,4"/>
                <ScrollViewer x:Name="logScroll" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtLog" FontSize="11" Foreground="#848E9C"
                               TextWrapping="Wrap" FontFamily="Consolas"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TextBox x:Name="txtMqlLog" Width="1" Height="1" Opacity="0"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 IsHitTestVisible="False"/>
    </Grid>
</Window>
