<Window x:Class="WpfTestApp.HermesWpfTerminal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HermesWpfTerminal v27" Height="720" Width="980"
        MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#0B0E11"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <!-- Dark button: light text on dark bg, including hover -->
        <Style x:Key="DarkBtn" TargetType="Button">
            <Setter Property="Background" Value="#2B3139"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="BorderBrush" Value="#848E9C"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Cp"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383f49"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F0B90B"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#F8D12F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252C3B"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#EAECEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrderTypeTab" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="OrderTypeTabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderThickness="0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" Grid.Column="0" Width="3" Background="Transparent"
                                        HorizontalAlignment="Left" Margin="-10, -10, 6, -10"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#252C3B"/>
                                <Setter Property="Foreground" Value="#F8D12F"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2B3139"/>
                                <Setter TargetName="Accent" Property="Background" Value="#2A7DE1"/>
                                <Setter Property="Foreground" Value="#EAECEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sell: dark red hover, white/light text -->
        <Style x:Key="SellBtn" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#8E0000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8E0000"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F8D12F"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6A0000"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#EAECEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buy: dark green hover, white/light text -->
        <Style x:Key="BuyBtn" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1B5E20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B5E20"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F8D12F"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0D3B12"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#EAECEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2B3139"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="BorderBrush" Value="#848E9C"/>
            <Setter Property="CaretBrush" Value="#EAECEF"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- Dark ComboBox + dark dropdown popup (no light system chrome) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="Background" Value="#2B3139"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383f49"/>
                                <Setter Property="Foreground" Value="#F8D12F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252C3B"/>
                                <Setter Property="Foreground" Value="#F0B90B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2B3139"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="BorderBrush" Value="#848E9C"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" Background="#2B3139" BorderBrush="#848E9C" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#2B3139"/>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 6 6 L 12 0 Z" Fill="#EAECEF"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="#383f49"/>
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#F0B90B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Margin="8,4,28,4" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="#EAECEF"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#2B3139" BorderBrush="#848E9C" BorderThickness="1">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8D12F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#181A20" BorderBrush="#2B3139" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="ACCOUNT" FontSize="11" Foreground="#848E9C"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="txtAccount" Text="—" Foreground="#EAECEF" FontSize="12" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#181A20" BorderBrush="#2B3139" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnQuickSell" Width="140" Height="40" Margin="0,0,6,0"
                            Style="{StaticResource SellBtn}" FontSize="13" Content="SELL"/>
                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                        <TextBlock Text="Lot" FontSize="10" Foreground="#848E9C" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtLot" Width="64" Text="0.10" TextAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="btnQuickBuy" Width="140" Height="40" Margin="6,0,0,0"
                            Style="{StaticResource BuyBtn}" FontSize="13" Content="BUY"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <TextBlock x:Name="txtBuildVersion" Text="v?" FontSize="12" FontWeight="SemiBold"
                               Foreground="#F0B90B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="btnSessionsCalendar"
                            Style="{StaticResource DarkBtn}" Content="Sessions…"
                            Padding="10,8" Margin="0,0,6,0" HorizontalContentAlignment="Center"/>
                    <Button x:Name="btnSettings"
                            Style="{StaticResource DarkBtn}" Content="Settings…"
                            Padding="10,8" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- MT5-style order type tabs (left) -->
            <Border Grid.Column="0" Background="#181A20" BorderBrush="#2B3139" BorderThickness="1" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,6,0,0">
                        <RadioButton x:Name="tabMarket" Style="{StaticResource OrderTypeTab}" IsChecked="True" Tag="Market">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="26" Height="26" Margin="0,0,8,0" SnapsToDevicePixels="True">
                                    <Canvas Width="32" Height="32">
                                        <!-- Market: blue zigzag + large arrow -->
                                        <Path Stroke="#42A5F5" StrokeThickness="2.4" Fill="Transparent"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 3,26 L 9,16 L 14,21 L 20,10"/>
                                        <Path Fill="#42A5F5" Data="M 17.5,12.5 L 29,4 L 21.5,15.5 Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Market Execution" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="tabLimit" Style="{StaticResource OrderTypeTab}" Tag="Limit">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="26" Height="26" Margin="0,0,8,0" SnapsToDevicePixels="True">
                                    <Canvas Width="32" Height="32">
                                        <!-- Limit: grey level, approach from above, red trigger, blue arrow up -->
                                        <Line X1="4" Y1="20" X2="28" Y2="20" Stroke="#B0B8C4" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="5" Y1="8" X2="14" Y2="20" Stroke="#848E9C" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="11" Canvas.Top="17" Width="6" Height="6" Fill="#E53935"
                                                 Stroke="#FF8A80" StrokeThickness="0.8"/>
                                        <Line X1="14" Y1="20" X2="22" Y2="9" Stroke="#42A5F5" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Fill="#42A5F5" Data="M 18.5,8.5 L 28,5 L 22.5,13.5 Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Limit Order" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="tabStop" Style="{StaticResource OrderTypeTab}" Tag="Stop">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="26" Height="26" Margin="0,0,8,0" SnapsToDevicePixels="True">
                                    <Canvas Width="32" Height="32">
                                        <!-- Stop: grey level, blue path crosses through red trigger -->
                                        <Line X1="4" Y1="16" X2="28" Y2="16" Stroke="#B0B8C4" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="5" Y1="26" X2="14" Y2="16" Stroke="#42A5F5" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="11" Canvas.Top="13" Width="6" Height="6" Fill="#E53935"
                                                 Stroke="#FF8A80" StrokeThickness="0.8"/>
                                        <Line X1="14" Y1="16" X2="22" Y2="7" Stroke="#42A5F5" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Fill="#42A5F5" Data="M 18.5,6.5 L 28,3.5 L 22.5,12 Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Stop Order" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="tabStopLimit" Style="{StaticResource OrderTypeTab}" Tag="StopLimit">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="26" Height="26" Margin="0,0,8,0" SnapsToDevicePixels="True">
                                    <Canvas Width="32" Height="32">
                                        <!-- Миниатюра = большая схема: Stop (зелёный) сверху, Limit (красный) снизу,
                                             путь: точка → Stop → Limit → стрелка вверх. -->
                                        <Line X1="2" Y1="9" X2="30" Y2="9" Stroke="#43A047" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="2" Y1="20" X2="30" Y2="20" Stroke="#E53935" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Stroke="#EAECEF" StrokeThickness="2" Fill="Transparent"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 5,28 L 12,10 L 18,20 L 24,4"/>
                                        <Ellipse Canvas.Left="1.5" Canvas.Top="24.5" Width="7" Height="7"
                                                 Fill="#1E88E5" Stroke="#FFFFFF" StrokeThickness="1"/>
                                        <Path Fill="#EAECEF" Data="M 20.5,6 L 30,1 L 24,11 Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Stop Limit Order" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="10,0,10,10">
                        <Separator Background="#2B3139" Margin="0,0,0,10"/>
                        <TextBlock x:Name="txtSymbol" Text="—" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#F0B90B" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Bid" FontSize="10" Foreground="#848E9C"/>
                                <TextBlock x:Name="txtBid" Text="0.00000" FontSize="15" FontWeight="Bold" Foreground="#EAECEF"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ask" FontSize="10" Foreground="#848E9C"/>
                                <TextBlock x:Name="txtAsk" Text="0.00000" FontSize="15" FontWeight="Bold" Foreground="#EAECEF"/>
                            </StackPanel>
                        </Grid>
                        <!-- Скрытые чекбоксы: GuiController подписывается только на главное окно;
                             видимые флаги живут в SettingsWindow и синхронизируются сюда. -->
                        <CheckBox x:Name="chkAutoTrade" Content="Auto-trade" Visibility="Collapsed"/>
                        <CheckBox x:Name="chkRealTrade" Visibility="Collapsed"
                                  Content="Real trading (test)"/>
                        <Button x:Name="btnSettingsClosed" Content="settings-closed" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#181A20" BorderBrush="#2B3139" BorderThickness="1" Padding="10"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="560">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Order form -->
                    <Grid Grid.Column="0" Margin="0,0,12,0" MinWidth="340">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="txtOrderModeTitle" Grid.Row="0" Text="Market Execution"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#EAECEF" Margin="0,0,0,10"/>

                        <Grid Grid.Row="1" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="cmbOrderType" Width="1" Height="1" Opacity="0"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"
                                      IsHitTestVisible="False" SelectedIndex="0">
                                <ComboBoxItem Content="Market"/>
                                <ComboBoxItem Content="Buy Limit"/>
                                <ComboBoxItem Content="Sell Limit"/>
                                <ComboBoxItem Content="Buy Stop"/>
                                <ComboBoxItem Content="Sell Stop"/>
                                <ComboBoxItem Content="Buy Stop Limit"/>
                                <ComboBoxItem Content="Sell Stop Limit"/>
                            </ComboBox>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Volume" Foreground="#848E9C" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtVolume" Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                     Text="0.10" Margin="0,0,0,6"/>

                            <TextBlock x:Name="lblPrice" Grid.Row="1" Grid.Column="0" Text="Price" Foreground="#848E9C" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtPrice" Grid.Row="1" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                     Text="0.000" Margin="0,0,0,6"/>

                            <TextBlock x:Name="lblStopLimit" Grid.Row="2" Grid.Column="0" Text="Stop Limit price" Foreground="#848E9C" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtStopLimit" Grid.Row="2" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                     Text="0.000" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Stop Loss" Foreground="#848E9C" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtSL" Grid.Row="3" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                     Text="0.000" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Take Profit" Foreground="#848E9C" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtTP" Grid.Row="4" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                     Text="0.000" Margin="0,0,0,6"/>

                            <TextBlock x:Name="lblFill" Grid.Row="5" Grid.Column="0" Text="Fill policy" Foreground="#848E9C" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbFill" Grid.Row="5" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                      Margin="0,0,0,6" SelectedIndex="0">
                                <ComboBoxItem Content="Fill or Kill"/>
                                <ComboBoxItem Content="Immediate or Cancel"/>
                                <ComboBoxItem Content="Return"/>
                            </ComboBox>

                            <TextBlock x:Name="lblExpiration" Grid.Row="6" Grid.Column="0" Text="Expiration" Foreground="#848E9C" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbExpiration" Grid.Row="6" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                      Margin="0,0,0,6" SelectedIndex="0">
                                <ComboBoxItem Content="GTC"/>
                                <ComboBoxItem Content="Today"/>
                                <ComboBoxItem Content="Specified"/>
                                <ComboBoxItem Content="Specified day"/>
                            </ComboBox>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Comment" Foreground="#848E9C" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtComment" Grid.Row="7" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                     Text="" Margin="0,0,0,10"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4">
                            <TextBlock x:Name="txtBidAskBig" FontSize="22" FontWeight="Bold" Foreground="#EAECEF"
                                       Text="— / —"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <Button x:Name="btnSellMarket" Content="Sell by Market" Width="150" Height="36" Margin="0,0,8,0"
                                    Style="{StaticResource SellBtn}"/>
                            <Button x:Name="btnBuyMarket" Content="Buy by Market" Width="150" Height="36" Margin="0,0,8,0"
                                    Style="{StaticResource BuyBtn}"/>
                            <Button x:Name="btnPlacePending" Content="Place Order" Width="140" Height="36" Visibility="Collapsed"
                                    Style="{StaticResource DarkBtn}" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Help diagram: fixed max size, does not grow with window -->
                    <Border Grid.Column="1" Background="#12151A" BorderBrush="#2B3139" BorderThickness="1"
                            Padding="8"
                            Width="320" Height="300"
                            MaxWidth="320" MaxHeight="300"
                            MinWidth="280" MinHeight="240"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <DockPanel>
                            <TextBlock x:Name="txtDiagramHint" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                       FontSize="11" Foreground="#848E9C" TextWrapping="Wrap"
                                       Text="Текущая цена — синяя точка."/>
                            <Canvas x:Name="orderDiagramCanvas" ClipToBounds="True"
                                    Width="300" Height="220"
                                    SizeChanged="OrderDiagramCanvas_SizeChanged"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#181A20" BorderBrush="#2B3139" BorderThickness="1" Padding="8" Margin="0,0,0,6">
            <TextBlock x:Name="txtMarketStatus" Text="Рынок: —" FontSize="11"
                       Foreground="#F0B90B" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="4" Background="#0B0E11" BorderBrush="#2B3139" BorderThickness="1" Padding="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="LOGS (WPF / MQL5)" FontSize="10"
                           Foreground="#848E9C" Margin="0,0,0,4"/>
                <ScrollViewer x:Name="logScroll" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtLog" FontSize="11" Foreground="#848E9C"
                               TextWrapping="Wrap" FontFamily="Consolas"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TextBox x:Name="txtMqlLog" Width="1" Height="1" Opacity="0"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 IsHitTestVisible="False"/>
    </Grid>
</Window>
