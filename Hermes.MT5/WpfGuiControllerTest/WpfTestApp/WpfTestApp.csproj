<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Library, не WinExe: никакого App.xaml/Main() — иначе будет конфликт
         точек входа с тем, как WpfGuiController грузит сборку через Assembly.LoadFrom. -->
    <OutputType>Library</OutputType>
    <RootNamespace>WpfTestApp</RootNamespace>
    <!-- Уникальное имя сборки: иначе MT5 LoadFrom возвращает уже загруженную старую WpfTestApp.dll -->
    <AssemblyName>HermesWpfTerminalUi29</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
