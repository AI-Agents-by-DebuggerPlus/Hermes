<Window x:Class="DesktopVoiceChat.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Height="640"
        Width="560"
        MinHeight="440"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Margin="0,0,0,4" Text="Supabase URL" />
                <TextBox x:Name="UrlBox"
                         Height="28"
                         VerticalContentAlignment="Center" />

                <TextBlock Margin="0,12,0,4" Text="Anon key" />
                <TextBox x:Name="KeyBox"
                         Height="28"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas" />

                <TextBlock Margin="0,12,0,4" Text="Имя отправителя" />
                <TextBox x:Name="SenderBox"
                         Height="28"
                         VerticalContentAlignment="Center" />

                <CheckBox x:Name="CheckAnonymous"
                          Margin="0,12,0,0"
                          Content="Анонимный вход (без email и пароля; включите Anonymous в Supabase → Authentication → Providers)" />

                <Separator Margin="0,20,0,12" />

                <TextBlock FontWeight="SemiBold"
                           Text="OpenAI (тестовые ответы в чате)" />
                <CheckBox x:Name="CheckOpenAi"
                          Margin="0,8,0,0"
                          Content="После моего сообщения запрашивать ответ и отправлять его в этот же чат (Supabase INSERT)" />

                <TextBlock Margin="0,12,0,4" Text="API key" />
                <TextBox x:Name="OpenAiKeyBox"
                         Height="28"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         ToolTip="Ключ пользователя Platform OpenAI — хранится только в локальном settings.json." />

                <TextBlock Margin="0,12,0,4" Text="Модель" />
                <TextBox x:Name="OpenAiModelBox"
                         Height="28"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         ToolTip="Например gpt-4o-mini" />

                <TextBlock Margin="0,12,0,4" Text="Имя бота в чате" />
                <TextBox x:Name="OpenAiBotBox"
                         Height="28"
                         VerticalContentAlignment="Center" />

                <TextBlock x:Name="HintPath"
                           Margin="0,16,0,0"
                           FontSize="11"
                           Foreground="Gray"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="100"
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Content="Отмена"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button MinWidth="100"
                    Padding="12,6"
                    Content="Сохранить"
                    IsDefault="True"
                    Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
