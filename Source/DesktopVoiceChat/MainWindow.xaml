<Window x:Class="DesktopVoiceChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DesktopVoiceChat.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Desktop Voice Chat"
        Height="720"
        Width="1000">
    <Window.Resources>
        <c:UtcToLocalDateTimeConverter x:Key="UtcToLocalDateTime" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <Button Margin="0,0,8,0"
                        Padding="12,6"
                        Content="Очистить чат"
                        Click="OnClearChatClick" />
                <Button Margin="0,0,8,0"
                        Padding="12,6"
                        Content="Настройки"
                        Click="OnSettingsClick" />
                <Button Padding="12,6"
                        Content="Журнал"
                        Click="OnLogWindowClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Padding="16,6"
                        Content="Connect"
                        Click="OnConnectClick" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Text="URL, anon key и имя — в «Настройки». При включённом анонимном входе пароль не нужен." />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView x:Name="MessagesListView"
                      Grid.Row="0"
                      ItemsSource="{Binding Messages}"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.CanContentScroll="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="8"
                                HorizontalAlignment="Stretch"
                                BorderBrush="#E5E5E5"
                                BorderThickness="1"
                                CornerRadius="4"
                                MaxWidth="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem},
                                                   Path=ActualWidth}">
                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Text="{Binding SenderName}" />
                                <TextBlock Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Text="{Binding Content}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Text="{Binding CreatedAt, Converter={StaticResource UtcToLocalDateTime}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.Row="1"
                       Margin="0,8,0,0"
                       Foreground="Gray"
                       Text="{Binding Status}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="DraftMessageBox"
                     Grid.Column="0"
                     Margin="0,0,8,0"
                     MinHeight="72"
                     MaxHeight="200"
                     VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     Text="{Binding DraftMessage, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="OnDraftPreviewKeyDown">
                <TextBox.ToolTip>
                    Enter — отправить; Shift+Enter — новая строка.
                </TextBox.ToolTip>
            </TextBox>
            <Button Grid.Column="1"
                    Padding="16,6"
                    Margin="0,0,8,0"
                    Content="Refresh"
                    Click="OnRefreshClick" />
            <Button Grid.Column="2"
                    Padding="16,6"
                    Content="Send"
                    Click="OnSendClick" />
        </Grid>
    </Grid>
</Window>
