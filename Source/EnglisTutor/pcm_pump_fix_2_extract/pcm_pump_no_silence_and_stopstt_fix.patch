+        _pcmPump?.SignalEnd();
+        _isSttRunning = false; // UI-bound flag, update button state from this
+        Task.Run(() =>
+        {
+            try
+            {
+                _engine?.RecognizeAsyncStop();
+                _engine?.Dispose();
+            }
+            catch (Exception ex)
+            {
+                Log.Error($"StopStt background cleanup failed: {ex}");
+            }
+        });
+        Log.Info("StopMicAsync begin (non-blocking)");
     }
