<UserControl x:Class="Hermes.InAppAssistant.Wpf.MiniAssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MiniAssistantConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <!-- FAB -->
        <Button Width="52"
                Height="52"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Command="{Binding ToggleOpenCommand}"
                ToolTip="ИИ-помощник (знает приложение)">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Content" Value="✦" />
                    <Setter Property="FontSize" Value="22" />
                    <Setter Property="Foreground" Value="#E8EEF4" />
                    <Setter Property="Background" Value="#2B6CB0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Visibility" Value="{Binding IsOpen, Converter={StaticResource BoolToInverseVisibility}, FallbackValue=Visible}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="26"
                                        Padding="0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Embedded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Panel -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Width="380"
                MaxHeight="520"
                Background="#1A2030"
                BorderBrush="#3A4A5E"
                BorderThickness="1"
                CornerRadius="10"
                Padding="0"
                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Embedded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Width" Value="NaN" />
                            <Setter Property="MaxHeight" Value="10000" />
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#243044"
                        CornerRadius="10,10,0,0"
                        Padding="12,10">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="AI Assistant"
                                       FontWeight="SemiBold"
                                       Foreground="#E8EEF4"
                                       FontSize="14" />
                            <TextBlock Text="OpenRouter · app-aware"
                                       Foreground="#8A9BB0"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Clear"
                                    Command="{Binding ClearCommand}"
                                    Margin="0,0,8,0"
                                    Padding="8,4"
                                    FontSize="11"
                                    Background="Transparent"
                                    Foreground="#8A9BB0"
                                    BorderBrush="#3A4A5E"
                                    Cursor="Hand" />
                            <Button Content="✕"
                                    Command="{Binding ToggleOpenCommand}"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    FontSize="14"
                                    Background="Transparent"
                                    Foreground="#8A9BB0"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Embedded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="10,8">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10,8"
                                        CornerRadius="8"
                                        Background="{Binding IsUser, Converter={StaticResource UserBubbleBrush}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Speaker}"
                                                   FontSize="10"
                                                   Foreground="#8A9BB0"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="#E8EEF4"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           Text="{Binding StatusText}"
                           Foreground="#6B7D92"
                           FontSize="10"
                           Margin="12,0,12,6"
                           TextWrapping="Wrap" />

                <Grid Grid.Row="3" Margin="10,0,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="36"
                             VerticalContentAlignment="Center"
                             Padding="8,6"
                             Background="#121820"
                             Foreground="#E8EEF4"
                             BorderBrush="#3A4A5E"
                             AcceptsReturn="False">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1"
                            Content="→"
                            Width="40"
                            Margin="8,0,0,0"
                            Command="{Binding SendCommand}"
                            IsEnabled="{Binding CanSend}"
                            Background="#2B6CB0"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Cursor="Hand" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
