<UserControl x:Class="Hermes.TradingPlatform.Wpf.Views.Pages.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Virtual exchange · размещение и отмена ордеров"
                   Foreground="{StaticResource Brush.TextMuted}"
                   Margin="0,0,0,12" />

        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Новый ордер" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Symbol" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Margin="0,0,12,8"
                              ItemsSource="{Binding Symbols}"
                              SelectedItem="{Binding NewSymbol, Mode=TwoWay}" />

                    <TextBlock Grid.Column="2" Text="Type" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3" Margin="0,0,12,8"
                              ItemsSource="{Binding OrderTypes}"
                              SelectedItem="{Binding NewOrderType, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1" Text="Side" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,0"
                              ItemsSource="{Binding Sides}"
                              SelectedItem="{Binding NewSide, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Price" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,12,0"
                             Text="{Binding NewPriceText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsPriceRequired}" />

                    <StackPanel Grid.Row="0" Grid.Column="4" Grid.RowSpan="2" VerticalAlignment="Center">
                        <TextBlock Text="Qty" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewQuantityText, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,0,8" />
                        <CheckBox Content="Reduce-only"
                                  IsChecked="{Binding NewReduceOnly, Mode=TwoWay}"
                                  Margin="0,0,0,8" />
                        <Button Content="Place order"
                                Command="{Binding PlaceOrderCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource PanelCardStyle}">
            <DataGrid ItemsSource="{Binding Orders}" Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" />
                    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
                    <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="60" />
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="90" />
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                    <DataGridTemplateColumn Header="RO" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding ReduceOnly, Mode=OneWay}"
                                          IsEnabled="False"
                                          Focusable="False"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ToolTip="Reduce-only" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Actions" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Modify" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="8,4"
                                            Command="{Binding DataContext.ModifyOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Cancel" Style="{StaticResource DangerButtonStyle}" Padding="8,4"
                                            Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
