<UserControl x:Class="Hermes.TradingPlatform.Wpf.Views.Pages.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Market · Limit · Stop · RO = reduce-only (read-only display, Phase 1 mock)"
                   Foreground="{StaticResource Brush.TextMuted}"
                   Margin="0,0,0,12" />
        <Border Style="{StaticResource PanelCardStyle}">
            <DataGrid ItemsSource="{Binding Orders}" Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" />
                    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
                    <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="60" />
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="90" />
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                    <DataGridTemplateColumn Header="RO" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding ReduceOnly, Mode=OneWay}"
                                          IsEnabled="False"
                                          Focusable="False"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ToolTip="Reduce-only (display only)" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Actions" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Modify" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="8,4"
                                            Command="{Binding DataContext.ModifyOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Cancel" Style="{StaticResource DangerButtonStyle}" Padding="8,4"
                                            Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
