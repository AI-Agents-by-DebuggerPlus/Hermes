<UserControl x:Class="Hermes.TradingPlatform.Wpf.Views.Pages.MarketWatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Market Watch · quick market Long/Short and row close"
                   Foreground="{StaticResource Brush.TextMuted}"
                   Margin="0,0,0,12" />
        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,8" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Qty for new orders:" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                <TextBox Width="100" Margin="8,0,0,0"
                         Text="{Binding TradeQuantityText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource PanelCardStyle}">
            <DataGrid ItemsSource="{Binding Tickers}" Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="★" Binding="{Binding WatchlistStar}" Width="40" />
                    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="120" />
                    <DataGridTextColumn Header="24h %" Binding="{Binding ChangeDisplay}" Width="80" />
                    <DataGridTextColumn Header="Volume" Binding="{Binding Volume24h, StringFormat=N0}" Width="120" />
                    <DataGridTemplateColumn Header="Trade" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Long" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" Margin="0,0,4,0"
                                            Command="{Binding DataContext.OpenLongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Short" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" Margin="0,0,4,0"
                                            Command="{Binding DataContext.OpenShortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Close" Style="{StaticResource DangerButtonStyle}" Padding="8,3"
                                            Command="{Binding DataContext.ClosePositionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Watch" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="★" Style="{StaticResource SecondaryButtonStyle}" Padding="6,2"
                                        Command="{Binding DataContext.ToggleWatchlistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
