<UserControl x:Class="Hermes.TradingPlatform.Wpf.Views.Pages.StrategiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Hermes.TradingPlatform.Wpf.Controls">
    <ItemsControl ItemsSource="{Binding Strategies}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource PanelCardStyle}" Width="280" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}" Margin="0,8,0,8" FontSize="12" />
                        <TextBlock FontSize="11">
                            <Run Text="Risk: " Foreground="{StaticResource Brush.TextMuted}" />
                            <Run Text="{Binding RiskProfile}" Foreground="{StaticResource Brush.Text}" />
                            <Run Text=" · Status: " Foreground="{StaticResource Brush.TextMuted}" />
                            <Run Text="{Binding Status}" Foreground="{StaticResource Brush.TextMuted}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                            <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Foreground="{StaticResource Brush.Text}" />
                            <ctrl:HelpHintIcon HelpText="Включить или выключить стратегию на следующих тиках" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Toggle" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding DataContext.ToggleStrategyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <ctrl:HelpHintIcon HelpText="То же, что чекбокс Enabled: переключить стратегию" Margin="6,0,0,0" />
                            <Button Content="Configure" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding DataContext.ConfigureStrategyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <ctrl:HelpHintIcon HelpText="Изменить размер позиции, порог и кулдаун стратегии" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
