<UserControl x:Class="Hermes.TradingPlatform.Wpf.Views.Pages.ReplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}">
            <StackPanel>
                <TextBlock Text="{Binding StatusLine}"
                           FontSize="16"
                           Foreground="{StaticResource Brush.Text}"
                           Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="▶ Play"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding PlayCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="⏸ Pause"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding PauseCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="⏮"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding StepBackCommand}"
                            Margin="0,0,4,0" />
                    <Button Content="⏭"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding StepForwardCommand}"
                            Margin="0,0,12,0" />
                    <Button Content="1x" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Speed1xCommand}" Margin="0,0,4,0" />
                    <Button Content="2x" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Speed2xCommand}" Margin="0,0,4,0" />
                    <Button Content="4x" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Speed4xCommand}" Margin="0,0,12,0" />
                    <Button Content="🔄 Reload"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ReloadCommand}" />
                </StackPanel>

                <Slider Minimum="0"
                        Maximum="{Binding MaxIndex, Mode=OneWay}"
                        Value="{Binding CurrentIndex, Mode=TwoWay}"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        Margin="0,4,0,8" />

                <TextBlock Text="{Binding CurrentSummary}"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Trade timeline"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding Entries}"
                          SelectedIndex="{Binding CurrentIndex, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          Background="{StaticResource Brush.PanelBackground}"
                          Foreground="{StaticResource Brush.Text}"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="80" />
                        <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="90" />
                        <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="60" />
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80" />
                        <DataGridTextColumn Header="Price" Binding="{Binding FillPrice, StringFormat=N2}" Width="100" />
                        <DataGridTextColumn Header="PnL" Binding="{Binding RealizedPnl, StringFormat=+0.00;-0.00;0.00}" Width="100" />
                        <DataGridTextColumn Header="Fee" Binding="{Binding Fee, StringFormat=N4}" Width="80" />
                        <DataGridTextColumn Header="Balance" Binding="{Binding BalanceAfter, StringFormat=N2}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
