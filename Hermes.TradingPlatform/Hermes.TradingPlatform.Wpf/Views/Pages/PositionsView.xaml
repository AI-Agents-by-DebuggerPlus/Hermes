<UserControl x:Class="Hermes.TradingPlatform.Wpf.Views.Pages.PositionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Ручная торговля · paper exchange без агента"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Margin="0,0,0,8" />
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Открыть позицию (market)" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Symbol" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Margin="0,0,12,0"
                                  ItemsSource="{Binding Symbols}"
                                  SelectedItem="{Binding TradeSymbol, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="Qty" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="3" Width="100" Margin="0,0,8,0"
                                 Text="{Binding TradeQuantityText, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button Content="Long"
                                    Command="{Binding OpenLongCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14,6"
                                    Margin="0,0,8,0" />
                            <Button Content="Short"
                                    Command="{Binding OpenShortCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14,6" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Открытые позиции" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <Button Content="Закрыть все"
                            Command="{Binding CloseAllCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            HorizontalAlignment="Right"
                            Padding="12,4" />
                </Grid>
                <DataGrid ItemsSource="{Binding Positions}" Style="{StaticResource DataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
                        <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="70" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" />
                        <DataGridTextColumn Header="Entry" Binding="{Binding EntryPrice, StringFormat=N2}" Width="90" />
                        <DataGridTextColumn Header="Mark" Binding="{Binding MarkPrice, StringFormat=N2}" Width="90" />
                        <DataGridTextColumn Header="uPnL" Binding="{Binding UnrealizedPnl, StringFormat=N2}" Width="80" />
                        <DataGridTextColumn Header="rPnL" Binding="{Binding RealizedPnl, StringFormat=N2}" Width="80" />
                        <DataGridTemplateColumn Header="Действие" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Закрыть"
                                            Command="{Binding DataContext.ClosePositionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="8,4" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Журнал сделок"
                           Style="{StaticResource SectionHeaderStyle}"
                           FontSize="13"
                           Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding Journal}" Style="{StaticResource DataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="72" />
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="56" />
                        <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="88" />
                        <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="48" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="64" />
                        <DataGridTextColumn Header="Price" Binding="{Binding FillPrice, StringFormat=N2}" Width="72" />
                        <DataGridTextColumn Header="Realized" Binding="{Binding RealizedPnl, StringFormat=N2}" Width="72" />
                        <DataGridTextColumn Header="Fee" Binding="{Binding Fee, StringFormat=N4}" Width="56" />
                        <DataGridTextColumn Header="Balance −" Binding="{Binding BalanceBefore, StringFormat=N2}" Width="88" />
                        <DataGridTextColumn Header="Balance +" Binding="{Binding BalanceAfter, StringFormat=N2}" Width="88" />
                        <DataGridTextColumn Header="Order" Binding="{Binding OrderId}" Width="72" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
