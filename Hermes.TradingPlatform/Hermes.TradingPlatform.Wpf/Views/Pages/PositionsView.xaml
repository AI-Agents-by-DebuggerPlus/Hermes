<UserControl x:Class="Hermes.TradingPlatform.Wpf.Views.Pages.PositionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelCardStyle}">
        <DataGrid ItemsSource="{Binding Positions}" Style="{StaticResource DataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
                <DataGridTextColumn Header="Direction" Binding="{Binding Side}" Width="80" />
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" />
                <DataGridTextColumn Header="Entry" Binding="{Binding EntryPrice, StringFormat=N2}" Width="100" />
                <DataGridTextColumn Header="Mark" Binding="{Binding MarkPrice, StringFormat=N2}" Width="100" />
                <DataGridTextColumn Header="Unrealized PnL" Binding="{Binding UnrealizedPnl, StringFormat=N2}" Width="110" />
                <DataGridTextColumn Header="Realized PnL" Binding="{Binding RealizedPnl, StringFormat=N2}" Width="100" />
                <DataGridTextColumn Header="Liq. Price" Binding="{Binding LiquidationPrice, StringFormat=N2}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </Border>
</UserControl>
