<UserControl x:Class="Hermes.TradingPlatform.Wpf.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720">
            <TextBlock Text="Platform settings (mock — Phase 1)"
                       Foreground="{StaticResource Brush.TextMuted}"
                       FontSize="12"
                       Margin="0,0,0,16" />

            <!-- Exchange -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Exchange" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mode" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ExchangeModes}"
                                  SelectedItem="{Binding ExchangeMode, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- API -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="API" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Endpoint / status" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding ApiEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- UI -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="UI" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Theme" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Theme, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Risk -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Risk defaults" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Default leverage" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding DefaultLeverageText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Replay -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Replay" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Data path" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding ReplayDataPath, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hermes -->
            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="Hermes integration (Phase 6)" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <TextBlock Text="Orchestration only — does not bypass Risk Manager."
                               Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <CheckBox Content="Enable Hermes orchestration layer"
                              IsChecked="{Binding HermesIntegrationEnabled, Mode=TwoWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
