<UserControl x:Class="Hermes.TradingPlatform.Wpf.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Hermes.TradingPlatform.Wpf.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720">
            <TextBlock Text="Platform settings · market data: Binance Futures USDT-M (public WebSocket) by default"
                       Foreground="{StaticResource Brush.TextMuted}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <!-- Market data -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Market data" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Source" Foreground="{StaticResource Brush.TextMuted}" />
                            <ctrl:HelpHintIcon HelpText="Mock — симуляция; Binance Futures — живые тики USDT-M" Margin="6,0,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding MarketDataModes}"
                                  SelectedItem="{Binding MarketDataMode, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Text="Endpoint" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ApiEndpoint, Mode=OneWay}" IsReadOnly="True" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Text="Status" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FeedStatus}" Foreground="{StaticResource Brush.Text}" Margin="0,8,0,0" />
                    </Grid>
                    <Button Content="Apply market data source"
                            Command="{Binding ApplyMarketDataCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Padding="12,6" />
                </StackPanel>
            </Border>

            <!-- Exchange -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Exchange" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mode" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ExchangeModes}"
                                  SelectedItem="{Binding ExchangeMode, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- API -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="API" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Execution" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="Virtual exchange (paper)" IsReadOnly="True" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- UI -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="UI" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Theme" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Theme, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox Content="Trade sounds (MetaTrader-style)"
                                  IsChecked="{Binding TradingSoundsEnabled, Mode=TwoWay}" />
                        <ctrl:HelpHintIcon HelpText="Системные звуки Windows при исполнении ордеров: открытие, закрытие, ошибка"
                                           Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Replay -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Replay" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Data path" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding ReplayDataPath, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Persistence -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Persistence" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <TextBlock Text="Trade journal backend. Switching takes effect after restart."
                               Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Journal provider" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding JournalProviders}"
                                  SelectedItem="{Binding JournalProvider, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Text="Active location" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding JournalLocation, Mode=OneWay}" IsReadOnly="True" Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,12"
                    Padding="12,10"
                    Background="#1A2330"
                    CornerRadius="6"
                    BorderBrush="#2A3A4E"
                    BorderThickness="1">
                <TextBlock Text="{Binding SettingsHintText}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{StaticResource Brush.TextMuted}" />
            </Border>

            <!-- Hermes -->
            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="Hermes integration (Phase 6)" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <TextBlock Text="Monitor / explain / review only. Does not place orders or bypass Risk Manager."
                               Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Enable Hermes orchestration layer"
                                  IsChecked="{Binding HermesIntegrationEnabled, Mode=TwoWay}" />
                        <ctrl:HelpHintIcon HelpText="Hermes наблюдает за сигналами стратегий; ордера не выставляет"
                                           Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
