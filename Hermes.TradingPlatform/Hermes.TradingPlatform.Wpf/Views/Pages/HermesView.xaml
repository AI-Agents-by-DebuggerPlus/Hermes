<UserControl x:Class="Hermes.TradingPlatform.Wpf.Views.Pages.HermesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Hermes.TradingPlatform.Wpf.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ctrl:HermesStateWidget State="{Binding Status.State}" ActiveStrategy="{Binding Status.ActiveStrategy}"
                                Confidence="{Binding Status.Confidence}" Mode="{Binding Status.Mode}" Margin="0,0,0,12" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Current reasoning (orchestrator)" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="{Binding CurrentReasoning}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="Strategy context" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding StrategyContext}" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="Active tasks" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,0" />
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,4" Foreground="{StaticResource Brush.Text}">
                                    <Run Text="• " Foreground="{StaticResource Brush.Text}" />
                                    <Run Text="{Binding Title}" Foreground="{StaticResource Brush.Text}" />
                                    <Run Text=" — " Foreground="{StaticResource Brush.TextMuted}" />
                                    <Run Text="{Binding Status}" Foreground="{StaticResource Brush.TextMuted}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Recent decisions" Style="{StaticResource SectionHeaderStyle}" />
                    <ItemsControl ItemsSource="{Binding Decisions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" />
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
