<UserControl x:Class="Hermes.TradingPlatform.Wpf.Views.Pages.RiskManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Hermes.TradingPlatform.Wpf.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Risk limits (persisted to disk)" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="{Binding EmergencyHaltBanner}"
                           Foreground="{StaticResource Brush.Negative}"
                           FontWeight="Bold"
                           Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EmergencyHalt}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="Max daily loss %" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <ctrl:HelpHintIcon HelpText="Дневной лимит просадки в процентах от депозита" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MaxDailyLossPercentText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="Risk per trade %" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <ctrl:HelpHintIcon HelpText="Максимальный риск на одну сделку в % от депозита (по умолчанию 1%)" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxRiskPerTradePercentText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="Max position size (BTC)" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <ctrl:HelpHintIcon HelpText="Абсолютный лимит размера позиции в BTC" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxPositionSizeBtcText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="Max leverage" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <ctrl:HelpHintIcon HelpText="Верхний предел кредитного плеча для счёта" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxLeverageText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="Max exposure %" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <ctrl:HelpHintIcon HelpText="Максимальная доля капитала в открытых позициях" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MaxExposurePercentText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="TP multiplier (×SL)" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <ctrl:HelpHintIcon HelpText="Take-profit = SL × множитель. По умолчанию 2 (RR 1:2)." Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DefaultTakeProfitRrMultiplierText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox Content="Auto SL/TP при открытии" IsChecked="{Binding AutoApplyDefaultSlTp}" Foreground="{StaticResource Brush.Text}" />
                        <ctrl:HelpHintIcon HelpText="Если SL/TP не указаны при размещении ордера, автоматически выставляются reduce-only стоп-лосс (по риску на сделку) и тейк-профит (= SL × множитель)." Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox Content="Safe Mode" IsChecked="{Binding SafeMode}" Foreground="{StaticResource Brush.Text}" />
                        <ctrl:HelpHintIcon HelpText="Разрешены только ордера reduce-only (сокращение позиции)" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <CheckBox Content="Auto-shutdown on breach" IsChecked="{Binding AutoShutdown}" Foreground="{StaticResource Brush.Text}" />
                        <ctrl:HelpHintIcon HelpText="Автоматически останавливать стратегии при превышении лимитов" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <StackPanel Grid.Column="1">
            <ctrl:RiskIndicator RiskLevel="{Binding RiskLevel}"
                                ExposurePercent="{Binding ExposurePercent}"
                                DailyDrawdownPercent="{Binding DailyDrawdownPercent}"
                                Margin="0,0,0,12" />
            <Button Content="EMERGENCY STOP" Style="{StaticResource DangerButtonStyle}"
                    Command="{Binding EmergencyStopCommand}" FontWeight="Bold" FontSize="14" />
            <TextBlock Text="Leverage (current)" Foreground="{StaticResource Brush.TextMuted}" Margin="0,16,0,4" />
            <TextBlock Text="{Binding CurrentLeverage, StringFormat={}{0:F1}x}" FontSize="24" Foreground="{StaticResource Brush.Text}" />
        </StackPanel>
    </Grid>
</UserControl>
