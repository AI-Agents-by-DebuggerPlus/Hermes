<Window x:Class="Hermes.TradingPlatform.Wpf.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Hermes.TradingPlatform.Wpf.Views.Shell"
        xmlns:ctrl="clr-namespace:Hermes.TradingPlatform.Wpf.Controls"
        xmlns:assistant="clr-namespace:Hermes.InAppAssistant.Wpf;assembly=Hermes.InAppAssistant.Wpf"
        Title="Hermes Trading Platform"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="640"
        Background="{StaticResource Brush.BgDeep}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource Brush.BgPanel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                    <TextBlock Text="HERMES" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}" />
                    <TextBlock Text="Trading Platform" FontSize="11" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0" />
                    <Border Background="#1A2330" CornerRadius="4" Padding="8,4" Margin="0,12,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="PHASE 1 · UI" FontSize="10" Foreground="{StaticResource Brush.Warning}" />
                    </Border>
                </StackPanel>
                <ListBox ItemsSource="{Binding NavItems}"
                         BorderThickness="0"
                         Background="Transparent"
                         Margin="8,0,8,8"
                         SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <DockPanel LastChildFill="True">
                                            <ctrl:HelpHintIcon DockPanel.Dock="Right"
                                                               HelpText="{Binding ToolTipRu}"
                                                               Margin="0,0,12,0"
                                                               VerticalAlignment="Center" />
                                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Page}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="12,10"
                                                    HorizontalContentAlignment="Left"
                                                    Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding IconGlyph}" Width="22" />
                                                                        <TextBlock Text="{Binding Title}" Margin="8,0,0,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#1E2836" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#243044" />
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            </Button>
                                        </DockPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="{StaticResource Brush.BgPanel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{Binding TopBarSubtitle}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#1E3A2F" CornerRadius="4" Padding="10,4" Margin="0,0,12,0">
                            <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource Brush.Positive}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding SessionClock}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <ctrl:AccountSummaryStrip Grid.Row="1" DataContext="{Binding}" />

            <!-- Content -->
            <Grid Grid.Row="2" Margin="20">
                <shell:PageContentPresenter PageViewModel="{Binding CurrentPage}">
                    <shell:PageContentPresenter.Style>
                        <Style TargetType="shell:PageContentPresenter">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAssistantTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </shell:PageContentPresenter.Style>
                </shell:PageContentPresenter>

                <Grid Visibility="{Binding IsAssistantTab, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="280" />
                    </Grid.RowDefinitions>
                    <shell:PageContentPresenter Grid.Row="0" PageViewModel="{Binding CurrentPage}" />
                    <assistant:MiniAssistantPanel Grid.Row="1"
                                                  DataContext="{Binding InAppAssistant}"
                                                  Embedded="True"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                </Grid>

                <assistant:MiniAssistantPanel DataContext="{Binding InAppAssistant}"
                                              Embedded="False"
                                              Panel.ZIndex="40"
                                              VerticalAlignment="Bottom"
                                              HorizontalAlignment="Right"
                                              Visibility="{Binding ShowFloatingAssistant, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
