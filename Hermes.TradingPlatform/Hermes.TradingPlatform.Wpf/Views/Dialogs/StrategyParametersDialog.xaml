<Window x:Class="Hermes.TradingPlatform.Wpf.Views.Dialogs.StrategyParametersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strategy parameters"
        Width="420"
        Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.BgDeep}">
    <Border Background="{StaticResource Brush.BgPanel}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            Padding="20"
            Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="HeaderText"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text}"
                       Margin="0,0,0,4" />
            <TextBlock Grid.Row="0"
                       x:Name="SubText"
                       FontSize="11"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Margin="0,18,0,12" />

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Order quantity"
                           Foreground="{StaticResource Brush.TextMuted}"
                           VerticalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         x:Name="QuantityBox"
                         Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="24h change threshold (%)"
                           Foreground="{StaticResource Brush.TextMuted}"
                           VerticalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         x:Name="ThresholdBox"
                         Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Cooldown (seconds)"
                           Foreground="{StaticResource Brush.TextMuted}"
                           VerticalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBox Grid.Row="2" Grid.Column="1"
                         x:Name="CooldownBox"
                         Margin="0,0,0,8" />
            </Grid>

            <TextBlock Grid.Row="2"
                       x:Name="StatusText"
                       Foreground="{StaticResource Brush.Negative}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       VerticalAlignment="Bottom" />

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Padding="14,6"
                        Click="OnCancel" />
                <Button x:Name="ApplyButton"
                        Content="Apply"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="14,6"
                        IsDefault="True"
                        Click="OnApply" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
