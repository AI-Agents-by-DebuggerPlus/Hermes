<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>Hermes.TradingPlatform.Wpf</RootNamespace>
    <ApplicationIcon />
    <AssemblyName>Hermes.TradingPlatform</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Supabase" Version="1.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hermes.TradingPlatform.Shared\Hermes.TradingPlatform.Shared.csproj" />
    <ProjectReference Include="..\Hermes.TradingPlatform.Core\Hermes.TradingPlatform.Core.csproj" />
    <ProjectReference Include="..\Hermes.TradingPlatform.Data\Hermes.TradingPlatform.Data.csproj" />
    <ProjectReference Include="..\Hermes.TradingPlatform.Exchange\Hermes.TradingPlatform.Exchange.csproj" />
    <ProjectReference Include="..\Hermes.TradingPlatform.Risk\Hermes.TradingPlatform.Risk.csproj" />
    <ProjectReference Include="..\Hermes.TradingPlatform.Strategies\Hermes.TradingPlatform.Strategies.csproj" />
    <ProjectReference Include="..\Hermes.TradingPlatform.Orchestration\Hermes.TradingPlatform.Orchestration.csproj" />
    <ProjectReference Include="..\..\Hermes.InAppAssistant.Wpf\Hermes.InAppAssistant.Wpf.csproj" />
  </ItemGroup>

  <Target Name="BuildInAppAssistantBeforeMarkupCompile"
          BeforeTargets="MarkupCompilePass1"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\..\Hermes.InAppAssistant.Wpf\Hermes.InAppAssistant.Wpf.csproj"
             Properties="Configuration=$(Configuration);Platform=$(Platform)" />
  </Target>
</Project>
