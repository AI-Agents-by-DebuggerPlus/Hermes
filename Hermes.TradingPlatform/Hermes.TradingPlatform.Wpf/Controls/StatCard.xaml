<UserControl x:Class="Hermes.TradingPlatform.Wpf.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="140">
    <Border Style="{StaticResource PanelCardStyle}">
        <StackPanel>
            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{StaticResource Brush.Text}"
                       FontSize="20"
                       FontWeight="Bold"
                       TextOptions.TextFormattingMode="Display" />
            <TextBlock Text="{Binding Subtext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{StaticResource Brush.TextMuted}"
                       FontSize="11"
                       Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</UserControl>
