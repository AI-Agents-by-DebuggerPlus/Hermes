<UserControl x:Class="Hermes.TradingPlatform.Wpf.Controls.HelpHintIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="16"
             Height="16"
             VerticalAlignment="Center"
             ToolTip="{Binding HelpText, ElementName=Root}"
             Cursor="Help">
    <Border Background="#243044"
            BorderBrush="#3A4A5E"
            BorderThickness="1"
            CornerRadius="8"
            Width="16"
            Height="16">
        <TextBlock Text="?"
                   FontSize="10"
                   FontWeight="Bold"
                   Foreground="{StaticResource Brush.TextMuted}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,-1,0,0" />
    </Border>
</UserControl>
