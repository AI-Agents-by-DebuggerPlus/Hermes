<UserControl x:Class="Hermes.TradingPlatform.Wpf.Controls.SidebarButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button Command="{Binding NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
            CommandParameter="{Binding Page, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Cursor="Hand"
            Margin="0,2"
            Padding="12,10"
            HorizontalContentAlignment="Left"
            BorderThickness="0">
        <Button.Style>
            <Style TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IconGlyph, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Width="22" FontSize="14" />
                                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1E2836" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#243044" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Button.Style>
    </Button>
</UserControl>
