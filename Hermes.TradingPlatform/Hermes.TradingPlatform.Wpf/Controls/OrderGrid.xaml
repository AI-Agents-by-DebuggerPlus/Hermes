<UserControl x:Class="Hermes.TradingPlatform.Wpf.Controls.OrderGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataGrid ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Style="{StaticResource DataGridStyle}">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
            <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="60" />
            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="90" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
