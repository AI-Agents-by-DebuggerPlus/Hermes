<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Supabase" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hermes.WpGallery\Hermes.WpGallery.csproj" />
    <ProjectReference Include="..\Hermes.WpGallery.Tool\Hermes.WpGallery.Tool.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Hermes.DesktopCapture\Hermes.DesktopCapture.csproj" />
    <ProjectReference Include="..\Hermes.DesktopInteraction\Hermes.DesktopInteraction.csproj" />
    <ProjectReference Include="..\Hermes.MouseBridge\Hermes.MouseBridge.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Hermes.TradingPlatform\Hermes.TradingPlatform.Shared\Hermes.TradingPlatform.Shared.csproj" />
    <ProjectReference Include="..\Hermes.SpotTerminal\Hermes.SpotTerminal.Shared\Hermes.SpotTerminal.Shared.csproj" />
    <ProjectReference Include="..\Hermes.Terminals.Shared\Hermes.Terminals.Shared.csproj" />
    <ProjectReference Include="..\Hermes.InAppAssistant.Wpf\Hermes.InAppAssistant.Wpf.csproj" />
  </ItemGroup>

  <!-- WPF MarkupCompilePass1 loads referenced control assemblies from bin/{Configuration}; build them first. -->
  <Target Name="BuildInAppAssistantBeforeMarkupCompile"
          BeforeTargets="MarkupCompilePass1"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\Hermes.InAppAssistant.Wpf\Hermes.InAppAssistant.Wpf.csproj"
             Properties="Configuration=$(Configuration);Platform=$(Platform)" />
  </Target>

  <Target Name="CopyWpGalleryToolToWpfOut" AfterTargets="Build">
    <PropertyGroup>
      <_GalleryTool>$(MSBuildThisFileDirectory)..\Hermes.WpGallery.Tool\bin\$(Configuration)\net8.0-windows\Hermes.WpGallery.Tool.exe</_GalleryTool>
    </PropertyGroup>
    <Copy SourceFiles="$(_GalleryTool)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_GalleryTool)')" />
  </Target>

  <!-- SpotTerminal must be built and fully copied (exe alone crashes without dependency DLLs). -->
  <Target Name="BuildSpotTerminalProjects"
          BeforeTargets="CopySpotTerminalToWpfOut"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\Hermes.SpotTerminal\Hermes.SpotTerminal.Wpf\Hermes.SpotTerminal.Wpf.csproj"
             Properties="Configuration=$(Configuration);Platform=$(Platform)" />
    <MSBuild Projects="..\Hermes.SpotTerminal\Hermes.SpotTerminal.Cli\Hermes.SpotTerminal.Cli.csproj"
             Properties="Configuration=$(Configuration);Platform=$(Platform)" />
  </Target>

  <Target Name="CopySpotTerminalToWpfOut" AfterTargets="Build">
    <PropertyGroup>
      <_SpotWpfDir>$(MSBuildThisFileDirectory)..\Hermes.SpotTerminal\Hermes.SpotTerminal.Wpf\bin\$(Configuration)\net8.0-windows\</_SpotWpfDir>
      <_SpotCliDir>$(MSBuildThisFileDirectory)..\Hermes.SpotTerminal\Hermes.SpotTerminal.Cli\bin\$(Configuration)\net8.0\</_SpotCliDir>
    </PropertyGroup>
    <ItemGroup>
      <_SpotWpfFiles Include="$(_SpotWpfDir)*.*" Exclude="$(_SpotWpfDir)*.pdb" />
      <_SpotCliFiles Include="$(_SpotCliDir)*.*" Exclude="$(_SpotCliDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_SpotWpfFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_SpotWpfDir)Hermes.SpotTerminal.exe')" />
    <Copy SourceFiles="@(_SpotCliFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_SpotCliDir)Hermes.SpotTerminal.Cli.exe')" />
  </Target>

  <Target Name="CopyTradingPlatformCliToWpfOut" AfterTargets="Build">
    <PropertyGroup>
      <_TpCliDir>$(MSBuildThisFileDirectory)..\Hermes.TradingPlatform\Hermes.TradingPlatform.Cli\bin\$(Configuration)\net8.0\</_TpCliDir>
      <_TpSharedDir>$(MSBuildThisFileDirectory)..\Hermes.TradingPlatform\Hermes.TradingPlatform.Shared\bin\$(Configuration)\net8.0\</_TpSharedDir>
    </PropertyGroup>
    <ItemGroup>
      <_TpCliFiles Include="$(_TpCliDir)Hermes.TradingPlatform.Cli.*" />
      <_TpSharedFiles Include="$(_TpSharedDir)Hermes.TradingPlatform.Shared.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TpCliFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(_TpCliDir)Hermes.TradingPlatform.Cli.dll')" />
    <Copy SourceFiles="@(_TpSharedFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(_TpSharedDir)Hermes.TradingPlatform.Shared.dll')" />
  </Target>

  <Target Name="CopyMouseBridgeToWpfOut" AfterTargets="Build">
    <PropertyGroup>
      <_MbDir>$(MSBuildThisFileDirectory)..\Hermes.MouseBridge\bin\$(Configuration)\net8.0-windows</_MbDir>
    </PropertyGroup>
    <Copy SourceFiles="$(_MbDir)\Hermes.MouseBridge.exe"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_MbDir)\Hermes.MouseBridge.exe')" />
    <Copy SourceFiles="$(_MbDir)\Hermes.MouseBridge.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_MbDir)\Hermes.MouseBridge.dll')" />
  </Target>

</Project>
