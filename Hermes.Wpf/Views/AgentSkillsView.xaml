<UserControl x:Class="Hermes.Wpf.Views.AgentSkillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="640">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Margin="0,0,0,12"
                Padding="12"
                Style="{StaticResource PanelBorderStyle}">
            <StackPanel DataContext="{Binding GeneratedSkills}">
                <TextBlock FontWeight="SemiBold"
                           Text="Сгенерированные навыки"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding StatusLine}"
                           TextWrapping="Wrap" />
                <WrapPanel Margin="0,10,0,0">
                    <Button MinWidth="120"
                            Margin="0,0,8,8"
                            Padding="8,4"
                            Command="{Binding RefreshCommand}"
                            Content="Обновить" />
                    <Button MinWidth="140"
                            Margin="0,0,8,8"
                            Padding="8,4"
                            Command="{Binding OpenFolderCommand}"
                            Content="Открыть папку" />
                </WrapPanel>
                <ListView x:Name="GeneratedSkillsList"
                          Margin="0,8,0,0"
                          MaxHeight="220"
                          BorderThickness="1"
                          ItemsSource="{Binding Items}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Id" Width="120" DisplayMemberBinding="{Binding Id}" />
                            <GridViewColumn Header="Название" Width="160" DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="Kind" Width="64" DisplayMemberBinding="{Binding Kind}" />
                            <GridViewColumn Header="On" Width="36" DisplayMemberBinding="{Binding Enabled}" />
                            <GridViewColumn Header="Триггеры" Width="180" DisplayMemberBinding="{Binding TriggersDisplay}" />
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <EventSetter Event="MouseDoubleClick" Handler="GeneratedSkillItem_OnDoubleClick" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <WrapPanel Margin="0,8,0,0">
                    <Button MinWidth="100"
                            Margin="0,0,8,0"
                            Padding="8,4"
                            Command="{Binding RunSkillCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=GeneratedSkillsList}"
                            Content="Запустить" />
                    <Button MinWidth="120"
                            Padding="8,4"
                            Command="{Binding ToggleEnabledCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=GeneratedSkillsList}"
                            Content="Вкл/Выкл" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Margin="0,0,0,12"
                Padding="12"
                Style="{StaticResource PanelBorderStyle}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="Показания воды — Рені (Водоканал)"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap">
                    Ежемесячно с 1-го по 5-е (команда «Передавать показания каждый месяц»). Догон при запуске, если пропустили. В чате: «Передай показания», «принял».
                </TextBlock>
                <WrapPanel Margin="0,12,0,0">
                    <Button MinWidth="200"
                            Margin="0,0,8,8"
                            Padding="10,6"
                            Command="{Binding LoginReniWaterCommand}"
                            Content="Вход на сайт (1 раз)" />
                    <Button MinWidth="200"
                            Margin="0,0,8,8"
                            Padding="10,6"
                            Command="{Binding CheckReniWaterSessionCommand}"
                            Content="Проверить сессию" />
                    <Button MinWidth="200"
                            Margin="0,0,8,8"
                            Padding="10,6"
                            Command="{Binding SubmitReniWaterCommand}"
                            Content="Передать показания" />
                    <Button MinWidth="160"
                            Margin="0,0,8,8"
                            Padding="10,6"
                            Command="{Binding AckReniWaterCommand}"
                            Content="Подтвердить (Ack)" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Margin="0,0,0,12"
                Padding="12"
                Style="{StaticResource PanelBorderStyle}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="Скриншот монитора + анализ"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap">
                    Снимок и внутренний контекст для агента. В чате — кратко; «опиши экран» — подробно; «переключись в Calculator» — элементы окна.
                </TextBlock>
                <Button MinWidth="220"
                        Margin="0,12,0,0"
                        Padding="10,6"
                        HorizontalAlignment="Left"
                        Command="{Binding CaptureDesktopScreenshotCommand}"
                        Content="Скриншот монитора" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Margin="0,12,0,0"
                Padding="12"
                Style="{StaticResource PanelBorderStyle}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="Проверка: курсор мыши"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap">
                    Сдвиг на 48 px вправо и возврат через ~320 ms. Сначала включите навык в Settings → «Управление курсором из Hermes.Wpf».
                </TextBlock>
                <Button MinWidth="232"
                        Margin="0,12,0,0"
                        Padding="10,6"
                        HorizontalAlignment="Left"
                        Command="{Binding SmokeTestMouseSkillCommand}"
                        Content="Сместить курсор (smoke test)" />
            </StackPanel>
        </Border>

        <ScrollViewer Padding="0,4,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AgentSkills}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border MinHeight="120"
                                Margin="0,0,10,10"
                                HorizontalAlignment="Stretch"
                                Padding="12,10"
                                Background="{StaticResource PanelBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding Category}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           LineHeight="18"
                                           Text="{Binding Summary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
