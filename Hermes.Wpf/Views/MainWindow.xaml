<Window x:Class="Hermes.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Hermes.Wpf.Views"
        mc:Ignorable="d"
        Title="Hermes Command Center"
        Height="700"
        Width="1000"
        MinHeight="600"
        MinWidth="720"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="12" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:StatusIndicator Grid.Row="0" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:ProjectPanel Grid.Column="0" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="370" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" HorizontalAlignment="Right">
                    <Button Width="90"
                            Margin="0,0,8,0"
                            Content="Setup"
                            Click="OpenSetupButton_OnClick" />
                    <Button Width="90"
                            Margin="0,0,8,0"
                            Content="Settings"
                            Click="OpenSettingsButton_OnClick" />
                    <Button Width="90"
                            Margin="0,0,8,0"
                            Content="Help"
                            Click="OpenHelpButton_OnClick" />
                    <Button Width="90"
                            Margin="0,0,8,0"
                            Content="Chat"
                            Click="OpenChatButton_OnClick" />
                    <Button Width="118"
                            Margin="0,0,8,0"
                            Content="Supabase test"
                            Click="OpenSupabaseTestChat_OnClick" />
                    <Button Width="90"
                            Content="Logs"
                            Click="OpenLogsButton_OnClick" />
                </WrapPanel>

                <views:TerminalView Grid.Row="2" />
            </Grid>
        </Grid>
    </Grid>
</Window>
