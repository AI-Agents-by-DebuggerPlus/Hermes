<Window x:Class="Hermes.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Hermes.Wpf.Views"
        mc:Ignorable="d"
        Title="Hermes Command Center"
        Height="700"
        Width="1000"
        MinHeight="600"
        MinWidth="720"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="12" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:StatusIndicator Grid.Row="0" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:ProjectPanel Grid.Column="0" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" HorizontalAlignment="Right">
                    <Button Width="90"
                            Margin="0,0,8,0"
                            Content="Setup"
                            Click="OpenSetupButton_OnClick" />
                    <Button Width="90"
                            Margin="0,0,8,0"
                            Content="Settings"
                            Click="OpenSettingsButton_OnClick" />
                    <Button Width="90"
                            Margin="0,0,8,0"
                            Content="Help"
                            Click="OpenHelpButton_OnClick" />
                    <Button Width="90"
                            Margin="0,0,8,0"
                            Content="Chat"
                            Click="OpenChatButton_OnClick" />
                    <CheckBox Margin="4,0,12,8"
                              VerticalAlignment="Center"
                              Content="Пауза агента"
                              IsChecked="{Binding HermesAgentPaused, Mode=TwoWay}"
                              ToolTip="Не вызывать Hermes для локального чата и входящих из Supabase; сообщения в UI и отправка ваших строк в Supabase при активном relay сохраняются. Быстрые действия (Status, Gateway) по-прежнему идут в CLI." />
                    <Button Width="118"
                            Margin="0,0,8,8"
                            Content="Supabase test"
                            Click="OpenSupabaseTestChat_OnClick" />
                    <Button Width="115"
                            Margin="0,0,8,8"
                            Content="External Brain"
                            Click="OpenExternalBrain_OnClick" />
                    <Button Width="138"
                            Margin="0,0,8,8"
                            Content="💾 Save experience"
                            ToolTip="Сохранить черновик опыта в Obsidian vault (Memory)"
                            Click="OpenSaveExperience_OnClick" />
                    <Button Width="170"
                            Margin="0,0,8,8"
                            Content="📤 Export English progress"
                            ToolTip="Экспорт прогресса репетитора английского в Obsidian (Memory/Knowledge/EnglishTutor и Sessions)"
                            Command="{Binding ExportEnglishTutorProgressCommand}" />
                    <Button Width="90"
                            Margin="0,0,8,8"
                            Content="Logs"
                            Click="OpenLogsButton_OnClick" />
                </WrapPanel>

                <TabControl Grid.Row="2"
                            Padding="0,4,0,0"
                            Style="{StaticResource HermesMainTabControlStyle}">
                    <TabControl.Resources>
                        <Style BasedOn="{StaticResource HermesAccentTabItemStyle}" TargetType="TabItem" />
                    </TabControl.Resources>
                    <TabItem Header="Терминал">
                        <views:TerminalView Margin="0,8,0,0" />
                    </TabItem>
                    <TabItem Header="Память WSL">
                        <views:WslMemoryView Margin="0,8,0,0"
                                             DataContext="{Binding WslMemory}" />
                    </TabItem>
                    <TabItem Header="Навыки">
                        <views:AgentSkillsView Margin="0,8,0,0" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
