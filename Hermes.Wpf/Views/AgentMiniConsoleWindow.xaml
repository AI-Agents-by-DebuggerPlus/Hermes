<Window x:Class="Hermes.Wpf.Views.AgentMiniConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Console"
        Width="520" Height="360"
        MinWidth="360" MinHeight="240"
        Background="#0B0E11" Foreground="#EAECEF"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,4" Click="Refresh_Click"
              Background="#2B3139" Foreground="#EAECEF" BorderBrush="#383f49"/>
      <TextBlock x:Name="TitleLabel" FontWeight="SemiBold" Foreground="#F8D12F" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Только текущий Agent Workspace" Foreground="#848E9C" FontSize="11" Margin="0,6,0,0"/>
    <ListBox x:Name="LogList" Background="#181A20" BorderBrush="#2B3139" Foreground="#EAECEF"
             FontFamily="Consolas" FontSize="12"/>
  </DockPanel>
</Window>
