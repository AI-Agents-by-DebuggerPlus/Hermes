<Window x:Class="Hermes.Wpf.Views.HermesReplyToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes"
        Width="360"
        Height="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <Border CornerRadius="10"
            BorderThickness="1"
            BorderBrush="#F0B90B"
            Background="#181A20"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <TextBlock x:Name="TitleText"
                           DockPanel.Dock="Left"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#F8D12F"
                           Text="Hermes ответил" />
                <Button DockPanel.Dock="Right"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        Content="×"
                        FontSize="14"
                        Background="Transparent"
                        Foreground="#848E9C"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Close_OnClick" />
            </DockPanel>

            <TextBlock x:Name="ProjectText"
                       Grid.Row="2"
                       FontSize="11"
                       Foreground="#848E9C"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock x:Name="BodyText"
                       Grid.Row="4"
                       FontSize="13"
                       Foreground="#EAECEF"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="5"
                       Margin="0,8,0,0"
                       FontSize="11"
                       Foreground="#848E9C"
                       Text="Клик — закрыть и перейти к чату" />
        </Grid>
    </Border>
</Window>
