<Window x:Class="Hermes.Wpf.Views.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hermes Logs"
        Height="560"
        Width="980"
        MinHeight="420"
        MinWidth="760"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="14"
                   Text="{Binding Header}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Orientation="Vertical">
            <CheckBox Content="Передавать логи в Supabase → RemoteTerminal (резервный просмотр)"
                      IsChecked="{Binding RemoteLogEnabled}"
                      Margin="0,0,0,4" />
            <CheckBox Content="Включая INFO (иначе только WARN / ERROR / TERM)"
                      IsChecked="{Binding RemoteLogIncludeInfo}"
                      IsEnabled="{Binding RemoteLogEnabled}"
                      Margin="0,0,0,4" />
            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="Нужны Relay enabled + URL/key. RemoteTerminal.Xp читает recipient_name=RemoteTerminal. Формат: [LOG:HermesWpf] …" />
        </StackPanel>

        <ListBox Grid.Row="4"
                 x:Name="LogsListBox"
                 ItemsSource="{Binding Entries}"
                 FontFamily="Consolas"
                 FontSize="12" />
    </Grid>
</Window>
