<Window x:Class="Hermes.Wpf.Views.ProjectManagerDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectManager Dashboard"
        Width="1100" Height="560"
        MinWidth="860" MinHeight="400"
        Background="#0B0E11" Foreground="#EAECEF"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Refresh" Padding="12,6" Click="Refresh_Click"
                Background="#2B3139" Foreground="#EAECEF" BorderBrush="#383f49"/>
        <TextBlock Text="ProjectManager Dashboard" FontSize="18" FontWeight="SemiBold" Foreground="#F8D12F"/>
      </DockPanel>
      <TextBlock Margin="0,4,0,0" Foreground="#848E9C" FontSize="12" TextWrapping="Wrap"
                 Text="Учёт инициатив (не реализация). Current → In development → Idea → Archive."/>
      <TextBlock x:Name="PathLabel" Margin="0,4,0,0" Foreground="#848E9C" FontSize="11"/>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Current" FontWeight="SemiBold" Foreground="#3FB950" Margin="0,0,0,8"/>
        <ListBox x:Name="CurrentList" Background="#181A20" BorderBrush="#2B3139" Foreground="#EAECEF" DisplayMemberPath="Line"/>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="In development" FontWeight="SemiBold" Foreground="#22D3EE" Margin="0,0,0,8"/>
        <ListBox x:Name="DevList" Background="#181A20" BorderBrush="#2B3139" Foreground="#EAECEF" DisplayMemberPath="Line"/>
      </DockPanel>
      <DockPanel Grid.Column="4">
        <TextBlock DockPanel.Dock="Top" Text="Idea" FontWeight="SemiBold" Foreground="#F0B90B" Margin="0,0,0,8"/>
        <ListBox x:Name="IdeaList" Background="#181A20" BorderBrush="#2B3139" Foreground="#EAECEF" DisplayMemberPath="Line"/>
      </DockPanel>
      <DockPanel Grid.Column="6">
        <TextBlock DockPanel.Dock="Top" Text="Archive" FontWeight="SemiBold" Foreground="#848E9C" Margin="0,0,0,8"/>
        <ListBox x:Name="ArchiveList" Background="#181A20" BorderBrush="#2B3139" Foreground="#EAECEF" DisplayMemberPath="Line"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
