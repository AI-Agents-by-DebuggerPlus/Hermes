<Window x:Class="Hermes.Wpf.Views.ProjectManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Workspaces"
        Height="640"
        Width="920"
        MinHeight="480"
        MinWidth="640"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left"
                       Style="{StaticResource HeaderTextStyle}"
                       VerticalAlignment="Center"
                       Text="Agent Workspaces" />
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="110"
                        Height="30"
                        Margin="0,0,8,0"
                        Content="Обзор…"
                        Command="{Binding BrowseProjectFolderCommand}" />
                <Button Width="36"
                        Height="30"
                        Margin="0,0,8,0"
                        Content="▲"
                        Command="{Binding MoveProjectUpCommand}"
                        ToolTip="Поднять выбранный workspace" />
                <Button Width="36"
                        Height="30"
                        Margin="0,0,8,0"
                        Content="▼"
                        Command="{Binding MoveProjectDownCommand}"
                        ToolTip="Опустить выбранный workspace" />
                <Button Width="120"
                        Height="30"
                        Content="Add Project"
                        Command="{Binding AddProjectCommand}" />
            </StackPanel>
        </DockPanel>

        <TextBox Grid.Row="2"
                 Height="30"
                 Text="{Binding NewProjectPath, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Путь к папке проекта" />

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="168"
                                Margin="0,0,12,12"
                                Padding="10"
                                CornerRadius="8"
                                BorderThickness="1"
                                Cursor="Hand"
                                MouseLeftButtonUp="Tile_OnMouseLeftButtonUp"
                                MouseLeftButtonDown="Tile_OnMouseLeftButtonDown"
                                ToolTip="{Binding WindowsPath}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#181A20" />
                                    <Setter Property="BorderBrush" Value="#30363D" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#F0B90B" />
                                            <Setter Property="Background" Value="#252C3B" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1F2430" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid Height="72" Margin="0,0,0,8">
                                    <Border Width="72"
                                            Height="72"
                                            HorizontalAlignment="Center"
                                            CornerRadius="36"
                                            Background="#2B3139"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="28"
                                                       FontWeight="SemiBold"
                                                       Foreground="#848E9C"
                                                       Text="{Binding Initial}" />
            <Image Stretch="UniformToFill"
                                                   Source="{Binding Avatar}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#EAECEF"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Name}"
                                           ToolTip="{Binding Name}" />

                                <Border Margin="0,6,0,0"
                                        Padding="6,2"
                                        HorizontalAlignment="Center"
                                        CornerRadius="4"
                                        Background="#2B3139"
                                        Visibility="{Binding EcosystemTitle, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                    <TextBlock FontSize="11"
                                               Foreground="{Binding EcosystemAccentBrush}"
                                               Text="{Binding EcosystemTitle}" />
                                </Border>

                                <Button Margin="0,10,0,0"
                                        Height="26"
                                        Padding="6,0"
                                        Background="#252C3B"
                                        BorderBrush="#30363D"
                                        Foreground="#EAECEF"
                                        Content="Аватар…"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.SetAvatarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />

                                <Button Margin="0,6,0,0"
                                        Height="26"
                                        Padding="6,0"
                                        Background="#252C3B"
                                        BorderBrush="#30363D"
                                        Foreground="#EAECEF"
                                        Content="Связанные"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.ShowRelatedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding HasRelated, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="120"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="Открыть чат"
                    Command="{Binding OpenChatCommand}" />
            <Button Width="100"
                    Height="32"
                    Content="Закрыть"
                    IsCancel="True"
                    Click="Close_OnClick" />
        </StackPanel>
    </Grid>
</Window>
