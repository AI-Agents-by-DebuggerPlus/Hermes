<Window x:Class="Hermes.Wpf.Views.MissedTaskPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пропущенная задача"
        Width="560" Height="420"
        MinWidth="480" MinHeight="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#0B0E11"
        Foreground="#EAECEF"
        FontFamily="Segoe UI"
        Topmost="True"
        ShowInTaskbar="True">
  <Border BorderBrush="#F0B90B" BorderThickness="1" Background="#181A20" Padding="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="12"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock x:Name="TitleText"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="#F8D12F"
                 TextWrapping="Wrap"
                 Text="Пропущенная задача"/>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="DetailText"
                   TextWrapping="Wrap"
                   Foreground="#EAECEF"
                   FontSize="13"
                   LineHeight="20"/>
      </ScrollViewer>

      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Width="110" Height="34" Margin="0,0,8,0"
                Content="Позже"
                Background="#2B3139" Foreground="#EAECEF" BorderBrush="#383f49"
                Cursor="Hand"
                Click="Later_OnClick">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                      CornerRadius="6" Padding="10,6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#383f49"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <Button x:Name="RunNowBtn" Width="140" Height="34"
                Content="Run Now"
                Background="#2A2410" Foreground="#F8D12F" BorderBrush="#F0B90B"
                FontWeight="SemiBold" Cursor="Hand"
                IsDefault="True"
                Click="RunNow_OnClick">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                      CornerRadius="6" Padding="10,6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#3A3214"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
