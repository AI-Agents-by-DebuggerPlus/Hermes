<UserControl x:Class="Hermes.Wpf.Views.WslMemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="760"
             Loaded="WslMemoryView_OnLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource HeaderTextStyle}"
                           FontSize="16"
                           Text="WSL memory" />

                <TextBlock DockPanel.Dock="Top"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding MemoriesDirectory}" />

                <TextBlock DockPanel.Dock="Top"
                           Margin="0,4,0,8"
                           TextWrapping="Wrap"
                           Text="{Binding StatusLine}" />

                <StackPanel DockPanel.Dock="Bottom"
                            Margin="0,8,0,0"
                            Orientation="Horizontal">
                    <Button Width="96"
                            Margin="0,0,8,0"
                            Content="Обновить"
                            Command="{Binding RefreshCommand}" />
                    <Button Width="132"
                            Margin="0,0,8,0"
                            Content="В vault"
                            Command="{Binding ExportToVaultCommand}"
                            ToolTip="Экспортировать USER.md и MEMORY.md в External Brain vault" />
                    <Button Width="112"
                            Content="Папка WSL"
                            Command="{Binding OpenFolderCommand}" />
                </StackPanel>

                <ListView Margin="0,8,0,0"
                          BorderBrush="{StaticResource BorderBrushDark}"
                          Background="{StaticResource InputBackgroundBrush}"
                          Foreground="{StaticResource PrimaryTextBrush}"
                          ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile, Mode=TwoWay}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="88"
                                            DisplayMemberBinding="{Binding FileName}"
                                            Header="Файл" />
                            <GridViewColumn Width="118"
                                            DisplayMemberBinding="{Binding LastWriteTimeLocal, StringFormat=yyyy-MM-dd HH:mm}"
                                            Header="Изменён" />
                            <GridViewColumn Width="40"
                                            DisplayMemberBinding="{Binding EntryCount}"
                                            Header="#" />
                            <GridViewColumn Width="150"
                                            DisplayMemberBinding="{Binding PreviewLine}"
                                            Header="Фрагмент" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource HeaderTextStyle}"
                           FontSize="16"
                           Text="Содержимое" />
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,8,0,8"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="USER.md — профиль пользователя; MEMORY.md — долгосрочные заметки агента. Запись выполняет Hermes CLI (инструмент memory), не Hermes.Wpf." />
                <TextBox Margin="0,0,0,0"
                         AcceptsReturn="True"
                         Background="{StaticResource InputBackgroundBrush}"
                         FontFamily="Consolas"
                         FontSize="13"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         IsReadOnly="True"
                         Text="{Binding SelectedContent, Mode=OneWay}"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
