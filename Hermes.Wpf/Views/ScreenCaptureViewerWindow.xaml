<Window x:Class="Hermes.Wpf.Views.ScreenCaptureViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скриншот монитора"
        Height="760"
        Width="1100"
        MinHeight="480"
        MinWidth="720"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        KeyDown="Window_OnKeyDown"
        ContentRendered="Window_OnContentRendered">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
            <TextBlock x:Name="SummaryText"
                       FontSize="13"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="PathText"
                       Margin="0,4,0,0"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border Grid.Row="2"
                Grid.Column="0"
                Background="#0d1117"
                BorderBrush="#30343D"
                BorderThickness="1"
                CornerRadius="6">
            <ScrollViewer x:Name="Scroller"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="Scroller_OnPreviewMouseWheel">
                <Grid x:Name="PhotoHost" RenderTransformOrigin="0.5,0.5">
                    <Image x:Name="Photo" Stretch="None" />
                    <Canvas x:Name="Overlay"
                            IsHitTestVisible="False" />
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Grid.Column="2"
                Padding="10"
                Style="{StaticResource PanelBorderStyle}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           FontWeight="SemiBold"
                           Text="Области" />
                <TextBlock x:Name="RegionHintText"
                           Margin="0,6,0,10"
                           DockPanel.Dock="Top"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="«С разметкой» — готовый PNG. «Без разметки» — оригинал + оверлей."
                           TextWrapping="Wrap" />
                <ListBox x:Name="RegionList"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="RegionList_OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Label}"
                                           TextWrapping="Wrap" />
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding Detail}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4"
                   Grid.Column="0"
                   LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button MinWidth="36"
                        Margin="0,0,6,0"
                        Padding="8,4"
                        Click="ZoomOut_OnClick"
                        Content="−" />
                <Slider x:Name="ZoomSlider"
                        Width="160"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Maximum="400"
                        Minimum="25"
                        Value="100"
                        ValueChanged="ZoomSlider_OnValueChanged" />
                <Button MinWidth="36"
                        Margin="0,0,6,0"
                        Padding="8,4"
                        Click="ZoomIn_OnClick"
                        Content="+" />
                <Button MinWidth="52"
                        Margin="0,0,6,0"
                        Padding="8,4"
                        Click="ZoomReset_OnClick"
                        Content="100%" />
                <Button MinWidth="72"
                        Padding="8,4"
                        Click="ZoomFit_OnClick"
                        Content="В окно" />
            </StackPanel>
            <TextBlock x:Name="ZoomLabel"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Right"
                       FontSize="13"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="100%" />
        </DockPanel>

        <StackPanel Grid.Row="4"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button MinWidth="120"
                    Margin="0,0,8,0"
                    Padding="8,4"
                    Click="ShowRaw_OnClick"
                    Content="Без разметки" />
            <Button MinWidth="120"
                    Padding="8,4"
                    Click="ShowAnnotated_OnClick"
                    Content="С разметкой" />
        </StackPanel>
    </Grid>
</Window>
