<UserControl x:Class="Hermes.Wpf.Views.ProjectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Style="{StaticResource PanelBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource HeaderTextStyle}" Text="Project Manager" />
            <TextBox Grid.Row="2"
                     Height="30"
                     Text="{Binding Projects.NewProjectPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Полный путь Windows к папке проекта, например D:\Work\HermesAgent" />

            <StackPanel Grid.Row="4"
                        Height="34"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <Button Width="112"
                        Height="30"
                        Margin="0,0,10,0"
                        Content="Add Project"
                        Command="{Binding AddProjectCommand}"
                        ToolTip="Добавить папку из поля или из «Обзор…»" />
                <Button Width="112"
                        Height="30"
                        Content="Обзор…"
                        Command="{Binding BrowseProjectFolderCommand}"
                        ToolTip="Выбрать папку в диалоге" />
            </StackPanel>

            <ListBox Grid.Row="4"
                     Margin="0,46,0,0"
                     ItemsSource="{Binding Projects.Projects}"
                     SelectedItem="{Binding Projects.SelectedProject, Mode=TwoWay}"
                     DisplayMemberPath="Name" />

            <TextBlock Grid.Row="6" Style="{StaticResource HeaderTextStyle}" Text="Quick Actions" />
            <Button Grid.Row="8"
                    Height="30"
                    Content="Status"
                    Command="{Binding StatusCommand}"
                    ToolTip="Hermes CLI: вызов `status` в WSL для выбранного проекта (работоспособность агента, без сообщения модели)." />
            <Button Grid.Row="10"
                    Height="30"
                    Content="Gateway Run"
                    Command="{Binding GatewayRunCommand}"
                    ToolTip="Hermes CLI: `gateway run` — поднять/проверить gateway внутри текущего проекта." />
            <Button Grid.Row="12"
                    Height="30"
                    Content="Reset Webhook"
                    Command="{Binding ResetWebhookCommand}"
                    ToolTip="Hermes CLI: `gateway reset-webhook` — сброс точки входа webhook (если заточено под ваш дистрибутив)." />
            <Button Grid.Row="14"
                    Height="30"
                    Content="Analyze Code"
                    Command="{Binding AnalyzeCodeCommand}"
                    ToolTip="Открыть обычный чат модели Hermes с запросом проанализировать код выбранного проекта (через `hermes chat`, не только терминальный quick-command)." />
        </Grid>
    </Border>
</UserControl>
