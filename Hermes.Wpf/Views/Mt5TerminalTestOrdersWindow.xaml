<Window x:Class="Hermes.Wpf.Views.Mt5TerminalTestOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mt5Terminal — тестовые ордера"
        Height="720" Width="980"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#0B0E11"
        Foreground="#EAECEF"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DarkBtn" TargetType="Button">
            <Setter Property="Background" Value="#2B3139"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="BorderBrush" Value="#848E9C"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383f49"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F0B90B"/>
                                <Setter Property="Foreground" Value="#F8D12F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252C3B"/>
                                <Setter Property="Foreground" Value="#EAECEF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BuyApplyBtn" TargetType="Button" BasedOn="{StaticResource DarkBtn}">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SellApplyBtn" TargetType="Button" BasedOn="{StaticResource DarkBtn}">
            <Setter Property="Background" Value="#8E0000"/>
            <Setter Property="BorderBrush" Value="#C62828"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource DarkBtn}"
                    Content="Обновить цены" Padding="12,6" Click="Refresh_OnClick"/>
            <StackPanel>
                <TextBlock Text="ТЕСТОВЫЕ КАРТОЧКИ ОРДЕРОВ" FontSize="12" FontWeight="SemiBold" Foreground="#F0B90B"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#848E9C" Margin="0,4,0,0"
                           Text="Entry / SL / TP считаются от текущей цены активного графика HWT (±0.08% / 0.15% / 0.25%). Apply → IPC Mt5Terminal (как Trading Analytics)."/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#181A20" BorderBrush="#2B3139" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock x:Name="QuoteText" FontSize="14" FontWeight="SemiBold" Foreground="#EAECEF"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="QuoteHint" DockPanel.Dock="Right" FontSize="11" Foreground="#848E9C"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CardsHost">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#181A20" BorderBrush="#2B3139" BorderThickness="1"
                                Margin="0,0,10,10" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="#F8D12F"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding KindLabel}"
                                               Foreground="#848E9C" FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Margin="0,0,0,6">
                                    <Run Text="{Binding SideText, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text=" · " Foreground="#848E9C"/>
                                    <Run Text="{Binding Symbol, Mode=OneWay}"/>
                                    <Run Text=" · lot " Foreground="#848E9C"/>
                                    <Run Text="{Binding Lot, Mode=OneWay}"/>
                                </TextBlock>
                                <Grid Grid.Row="2" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Entry" Foreground="#848E9C" FontSize="10"/>
                                        <TextBlock Text="{Binding EntryText}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="SL" Foreground="#848E9C" FontSize="10"/>
                                        <TextBlock Text="{Binding SlText}" Foreground="#F44336"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="TP" Foreground="#848E9C" FontSize="10"/>
                                        <TextBlock Text="{Binding TpText}" Foreground="#42A5F5"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="3" Text="{Binding Summary}" TextWrapping="Wrap"
                                           Foreground="#848E9C" FontSize="11" Margin="0,0,0,10"/>
                                <Button Grid.Row="4" Content="Apply"
                                        Tag="{Binding}"
                                        Click="Apply_OnClick"
                                        Style="{StaticResource BuyApplyBtn}"
                                        HorizontalAlignment="Left" MinWidth="110" Padding="14,6"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" FontSize="12"
                   Foreground="#848E9C" TextWrapping="Wrap"/>
    </Grid>
</Window>
