<Window x:Class="Hermes.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Closing="SettingsWindow_OnClosing"
        Height="860"
        Width="740"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12" MinHeight="520">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="WSL Distro" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding WslDistro, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Venv Path" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VenvPath, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Hermes Command" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding HermesCommand, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="Chat Timeout (sec)" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ChatTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="Chat font size (pt)" />
            <TextBox Grid.Row="8"
                     Grid.Column="1"
                     Width="90"
                     HorizontalAlignment="Left"
                     LostFocus="ChatFontSizeTextBox_OnLostFocus"
                     Text="{Binding ChatFontSizeEdit, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="Auto Reconnect" />
            <CheckBox Grid.Row="10" Grid.Column="1" IsChecked="{Binding AutoReconnect}" />

            <TextBlock Grid.Row="12"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Log Hermes commands (diag)"
                       TextWrapping="Wrap" />
            <CheckBox Grid.Row="12"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Content="Sanitized bash -lc in session log (also on DEBUG builds)"
                      IsChecked="{Binding DiagnosticLogHermesCommands}" />

            <TextBlock Grid.Row="14"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Hermes workspace root"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Row="14" Grid.Column="1" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Button Width="92"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Content="Обзор…"
                            Click="BrowseWorkspaceRoot_OnClick" />
                    <TextBox MinHeight="28"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Text="{Binding WorkspaceRootWindowsPath, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <TextBlock Margin="0,6,0,0"
                           Opacity="0.72"
                           TextWrapping="Wrap"
                           Text="Hermes выполняется с cd в эту папку (во все вложения). Поле очистите — использовать корень каждого выбранного проекта." />
            </StackPanel>

            <TextBlock Grid.Row="16"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Vision reminder for model"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Row="16" Grid.Column="1" VerticalAlignment="Center">
                <CheckBox Content="Append scope note to outbound chat (reduce false “I see your screen”)"
                          IsChecked="{Binding AppendVisionScopeReminder}" />
                <TextBlock Margin="0,6,0,0"
                           Opacity="0.72"
                           TextWrapping="Wrap"
                           Text="Only sent to hermes CLI, not shown in chat UI." />
            </StackPanel>

            <TextBlock Grid.Row="18"
                       Grid.Column="0"
                       VerticalAlignment="Top"
                       Margin="0,4,0,0"
                       Text="Custom reminder"
                       TextWrapping="Wrap" />
            <TextBox Grid.Row="18"
                     Grid.Column="1"
                     MinHeight="72"
                     MaxHeight="160"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"
                     Text="{Binding VisionScopeReminderNote, UpdateSourceTrigger=PropertyChanged}" />

            <Border Grid.Row="20"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Padding="0,8,0,0"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Opacity="0.85"
                               FontWeight="SemiBold"
                               Text="Supabase / voice relay (same table messages as DesktopVoiceChat)" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Relay enabled"
                               TextWrapping="Wrap" />
                    <CheckBox Grid.Row="2"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Content="Pull remote text and publish Hermes replies"
                              IsChecked="{Binding SupabaseRelayEnabled}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Supabase URL" />
                    <TextBox Grid.Row="4"
                             Grid.Column="1"
                             Text="{Binding SupabaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Anon API key"
                               TextWrapping="Wrap" />
                    <TextBox Grid.Row="6"
                             Grid.Column="1"
                             Text="{Binding SupabaseAnonKey, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="8"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Poll interval (sec)"
                               TextWrapping="Wrap" />
                    <TextBox Grid.Row="8"
                             Grid.Column="1"
                             Width="80"
                             HorizontalAlignment="Left"
                             Text="{Binding SupabasePollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="10"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Anonymous auth"
                               TextWrapping="Wrap" />
                    <CheckBox Grid.Row="10"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Content="Sign in anonymously (Dashboard → Anonymous provider)"
                              IsChecked="{Binding SupabaseUseAnonymousAuth}" />

                    <TextBlock Grid.Row="12"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Import full history"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Row="12" Grid.Column="1" VerticalAlignment="Center">
                        <CheckBox Content="On first connect append whole server transcript to chat (no agent rerun)"
                                  IsChecked="{Binding SupabaseImportFullHistoryOnConnect}" />
                        <TextBlock Margin="0,6,0,0"
                                   Opacity="0.72"
                                   TextWrapping="Wrap"
                                   Text="If off, only rows that appear after connect are injected; Hermes replies are still mirrored to Supabase." />
                    </StackPanel>

                    <TextBlock Grid.Row="14"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Desktop sender_name"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Row="14" Grid.Column="1" VerticalAlignment="Center">
                        <TextBox Width="160"
                                 HorizontalAlignment="Left"
                                 Text="{Binding SupabaseLocalSenderName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,6,0,0"
                                   Opacity="0.72"
                                   TextWrapping="Wrap"
                                   Text="Имя для строк из этого ПК; должно отличаться от Assistant sender_name и от Android." />
                    </StackPanel>

                    <TextBlock Grid.Row="16"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Assistant sender_name"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Row="16" Grid.Column="1" VerticalAlignment="Center">
                        <TextBox Width="160"
                                 HorizontalAlignment="Left"
                                 Text="{Binding SupabaseHermesSenderName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,6,0,0"
                                       Opacity="0.72"
                                       TextWrapping="Wrap"
                                       Text="Rows from Hermes use this sender_name so echoes are not duplicated; remote devices should use another name." />
                    </StackPanel>

                    <TextBlock Grid.Row="18"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Hermes-пауза"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Row="18"
                                Grid.Column="1"
                                VerticalAlignment="Center">
                        <CheckBox Content="Приостанавливать Hermes только для чата и входящих Supabase"
                                  IsChecked="{Binding HermesAgentPaused}" />
                        <TextBlock Margin="0,6,0,0"
                                   Opacity="0.72"
                                   TextWrapping="Wrap"
                                   Text="Соответствует галочке на главном окне. Ответ модели отключается; опрос таблицы messages и отправка сообщений этого ПК в Supabase (если relay включён) продолжаются." />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="22"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,16,0,0"
                        Orientation="Vertical">
                <Border Padding="0,8,0,0"
                        BorderBrush="{StaticResource BorderBrushDark}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Opacity="0.85"
                                   FontWeight="SemiBold"
                                   Text="External Brain (Obsidian / Markdown память)" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Папка vault"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <DockPanel LastChildFill="True">
                                <Button Width="92"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Content="Обзор…"
                                        Click="BrowseExternalBrainMemory_OnClick" />
                                <TextBox VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding ExternalBrainMemoryPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Margin="0,6,0,0"
                                       Opacity="0.72"
                                       TextWrapping="Wrap"
                                       Text="Recursive *.md Либо %AppData%\HermesWpf\externalBrain.json { &quot;MemoryPath&quot;: &quot;...&quot; } либо переменная HERMES_EXTERNAL_BRAIN_PATH." />
                        </StackPanel>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="В промпт Hermes"
                                   TextWrapping="Wrap" />
                        <CheckBox Grid.Row="4"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Content="Добавлять релевантные записи в исходящий hermes chat"
                                  IsChecked="{Binding ExternalBrainInjectIntoPrompt}" />

                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Max записей"
                                   TextWrapping="Wrap" />
                        <TextBox Grid.Row="6"
                                 Grid.Column="1"
                                 Width="72"
                                 HorizontalAlignment="Left"
                                 LostFocus="ExternalBrainMax_OnLostFocus"
                                 Text="{Binding ExternalBrainMaxContextItemsEdit, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="8"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Opacity="0.85"
                                   FontWeight="SemiBold"
                                   Text="Навык: курсор мыши (Windows)" />

                        <TextBlock Grid.Row="10"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Разрешить"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="10"
                                    Grid.Column="1"
                                    Orientation="Vertical">
                            <CheckBox VerticalAlignment="Center"
                                      Content="Управление курсором из Hermes.Wpf (тест «Навыки», прямые вызовы API)"
                                      IsChecked="{Binding DesktopMouseSkillEnabled}" />
                            <TextBlock Margin="0,8,0,0"
                                       Opacity="0.72"
                                       TextWrapping="Wrap"
                                       Text="Консоль Hermes.MouseBridge не проверяет этот флажок — её запускайте только когда доверяете источнику команд. Координаты — пиксели виртуального экрана." />
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Width="100"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        Content="Close"
                        Click="CloseButton_OnClick" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
