<Window x:Class="Hermes.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Closing="SettingsWindow_OnClosing"
        Height="860"
        Width="740"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12" MinHeight="520">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="WSL Distro" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding WslDistro, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Venv Path" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VenvPath, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Hermes Command" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding HermesCommand, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="Chat Timeout (sec)" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ChatTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="Chat font size (pt)" />
            <TextBox Grid.Row="8"
                     Grid.Column="1"
                     Width="90"
                     HorizontalAlignment="Left"
                     LostFocus="ChatFontSizeTextBox_OnLostFocus"
                     Text="{Binding ChatFontSizeEdit, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="Auto Reconnect" />
            <CheckBox Grid.Row="10" Grid.Column="1" IsChecked="{Binding AutoReconnect}" />

            <TextBlock Grid.Row="12"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Log Hermes commands (diag)"
                       TextWrapping="Wrap" />
            <CheckBox Grid.Row="12"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Content="Sanitized bash -lc in session log (also on DEBUG builds)"
                      IsChecked="{Binding DiagnosticLogHermesCommands}" />

            <TextBlock Grid.Row="14"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Hermes workspace root"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Row="14" Grid.Column="1" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Button Width="92"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Content="Обзор…"
                            Click="BrowseWorkspaceRoot_OnClick" />
                    <TextBox MinHeight="28"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Text="{Binding WorkspaceRootWindowsPath, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <TextBlock Margin="0,6,0,0"
                           Opacity="0.72"
                           TextWrapping="Wrap"
                           Text="Hermes выполняется с cd в эту папку (во все вложения). Поле очистите — использовать корень каждого выбранного проекта." />
            </StackPanel>

            <TextBlock Grid.Row="16"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Vision reminder for model"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Row="16" Grid.Column="1" VerticalAlignment="Center">
                <CheckBox Content="Append scope note to outbound chat (reduce false “I see your screen”)"
                          IsChecked="{Binding AppendVisionScopeReminder}" />
                <TextBlock Margin="0,6,0,0"
                           Opacity="0.72"
                           TextWrapping="Wrap"
                           Text="Only sent to hermes CLI, not shown in chat UI." />
            </StackPanel>

            <TextBlock Grid.Row="18"
                       Grid.Column="0"
                       VerticalAlignment="Top"
                       Margin="0,4,0,0"
                       Text="Custom reminder"
                       TextWrapping="Wrap" />
            <TextBox Grid.Row="18"
                     Grid.Column="1"
                     MinHeight="72"
                     MaxHeight="160"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"
                     Text="{Binding VisionScopeReminderNote, UpdateSourceTrigger=PropertyChanged}" />

            <Border Grid.Row="20"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Padding="0,8,0,0"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Opacity="0.85"
                               FontWeight="SemiBold"
                               Text="Supabase / voice relay (same table messages as DesktopVoiceChat)" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Relay enabled"
                               TextWrapping="Wrap" />
                    <CheckBox Grid.Row="2"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Content="Pull remote text and publish Hermes replies"
                              IsChecked="{Binding SupabaseRelayEnabled}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Supabase URL" />
                    <TextBox Grid.Row="4"
                             Grid.Column="1"
                             Text="{Binding SupabaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Anon API key"
                               TextWrapping="Wrap" />
                    <TextBox Grid.Row="6"
                             Grid.Column="1"
                             Text="{Binding SupabaseAnonKey, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="8"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="created_at timestamp"
                               TextWrapping="Wrap" />
                    <CheckBox Grid.Row="8"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Content="Use local system time (DateTimeOffset.Now) instead of UTC"
                              IsChecked="{Binding SupabaseUseLocalCreatedAt}" />

                    <TextBlock Grid.Row="10"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Poll interval (sec)"
                               TextWrapping="Wrap" />
                    <TextBox Grid.Row="10"
                             Grid.Column="1"
                             Width="80"
                             HorizontalAlignment="Left"
                             Text="{Binding SupabasePollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="12"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Anonymous auth"
                               TextWrapping="Wrap" />
                    <CheckBox Grid.Row="12"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Content="Sign in anonymously (Dashboard → Anonymous provider)"
                              IsChecked="{Binding SupabaseUseAnonymousAuth}" />

                    <StackPanel Grid.Row="14" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Top"
                                       Text="Import full history"
                                       TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <CheckBox Content="On first connect append whole server transcript to chat (no agent rerun)"
                                          IsChecked="{Binding SupabaseImportFullHistoryOnConnect}" />
                                <TextBlock Margin="0,6,0,0"
                                           Opacity="0.72"
                                           TextWrapping="Wrap"
                                           Text="If off, only rows that appear after connect are injected; Hermes replies are still mirrored to Supabase." />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Top"
                                       Text="Desktop sender_name"
                                       TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <TextBox Width="160"
                                         HorizontalAlignment="Left"
                                         Text="{Binding SupabaseLocalSenderName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0"
                                           Opacity="0.72"
                                           TextWrapping="Wrap"
                                           Text="Имя для строк из этого ПК; должно отличаться от Assistant sender_name и от Android." />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Top"
                                       Text="Assistant sender_name"
                                       TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <TextBox Width="160"
                                         HorizontalAlignment="Left"
                                         Text="{Binding SupabaseHermesSenderName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0"
                                           Opacity="0.72"
                                           TextWrapping="Wrap"
                                           Text="Rows from Hermes use this sender_name so echoes are not duplicated; remote devices should use another name." />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Top"
                                       Text="Hermes-пауза"
                                       TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <CheckBox Content="Приостанавливать Hermes только для чата и входящих Supabase"
                                          IsChecked="{Binding HermesAgentPaused}" />
                                <TextBlock Margin="0,6,0,0"
                                           Opacity="0.72"
                                           TextWrapping="Wrap"
                                           Text="Соответствует галочке на главном окне. Ответ модели отключается; опрос таблицы messages и отправка сообщений этого ПК в Supabase (если relay включён) продолжаются." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="22"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,16,0,0"
                        Orientation="Vertical">
                <Border Padding="0,8,0,0"
                        BorderBrush="{StaticResource BorderBrushDark}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Opacity="0.85"
                                   FontWeight="SemiBold"
                                   Text="External Brain (Obsidian / Markdown память)" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Папка vault"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <DockPanel LastChildFill="True">
                                <Button Width="92"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Content="Обзор…"
                                        Click="BrowseExternalBrainMemory_OnClick" />
                                <TextBox VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding ExternalBrainMemoryPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Margin="0,6,0,0"
                                       Opacity="0.72"
                                       TextWrapping="Wrap"
                                       Text="Recursive *.md Либо %AppData%\HermesWpf\externalBrain.json { &quot;MemoryPath&quot;: &quot;...&quot; } либо переменная HERMES_EXTERNAL_BRAIN_PATH." />
                        </StackPanel>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="В промпт Hermes"
                                   TextWrapping="Wrap" />
                        <CheckBox Grid.Row="4"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Content="Добавлять релевантные записи в исходящий hermes chat"
                                  IsChecked="{Binding ExternalBrainInjectIntoPrompt}" />

                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Max записей"
                                   TextWrapping="Wrap" />
                        <TextBox Grid.Row="6"
                                 Grid.Column="1"
                                 Width="72"
                                 HorizontalAlignment="Left"
                                 LostFocus="ExternalBrainMax_OnLostFocus"
                                 Text="{Binding ExternalBrainMaxContextItemsEdit, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="8"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Память WSL"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="8"
                                    Grid.Column="1"
                                    Orientation="Vertical">
                            <CheckBox VerticalAlignment="Center"
                                      Content="Экспортировать ~/.hermes/memories в vault (Identity/Knowledge)"
                                      IsChecked="{Binding SyncWslAgentMemoryToExternalBrain}" />
                            <TextBlock Margin="0,6,0,0"
                                       Opacity="0.72"
                                       TextWrapping="Wrap"
                                       Text="После ответа Hermes и при запуске Hermes.Wpf: USER.md и MEMORY.md из WSL копируются в Markdown-файлы vault; OneDrive синхронизирует их в облако." />
                        </StackPanel>

                        <TextBlock Grid.Row="10"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Vector memory"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="10"
                                    Grid.Column="1"
                                    Orientation="Vertical">
                            <CheckBox Content="Семантический поиск по vault (TF-IDF; Ollama — если доступен)"
                                      IsChecked="{Binding ExternalBrainVectorRetrievalEnabled}" />
                            <CheckBox Margin="0,8,0,0"
                                      Content="Пробовать Ollama embeddings (иначе только TF-IDF)"
                                      IsChecked="{Binding ExternalBrainUseOllamaEmbeddings}"
                                      IsEnabled="{Binding ExternalBrainVectorRetrievalEnabled}" />
                            <TextBlock Margin="0,8,0,0"
                                       Opacity="0.72"
                                       Text="Ollama URL" />
                            <TextBox Margin="0,4,0,0"
                                     IsEnabled="{Binding ExternalBrainVectorRetrievalEnabled}"
                                     Text="{Binding ExternalBrainOllamaBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,8,0,0"
                                       Opacity="0.72"
                                       Text="Embedding model" />
                            <TextBox Margin="0,4,0,0"
                                     IsEnabled="{Binding ExternalBrainVectorRetrievalEnabled}"
                                     Text="{Binding ExternalBrainEmbeddingModel, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0"
                                       Opacity="0.72"
                                       TextWrapping="Wrap"
                                       Text="Перед ответом Hermes: Querying vector memory… в логе. Кэш эмбеддингов: %AppData%\HermesWpf\embedding_cache." />
                        </StackPanel>

                        <TextBlock Grid.Row="12"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Opacity="0.85"
                                   FontWeight="SemiBold"
                                   Text="Role memory (самообучение по ролям)" />

                        <TextBlock Grid.Row="14"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Автосохранение"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="14"
                                    Grid.Column="1"
                                    Orientation="Vertical">
                            <CheckBox Content="Role auto-capture (importance ≥ порога → vault)"
                                      IsChecked="{Binding RoleAutoCapture}" />
                            <StackPanel Margin="24,8,0,0" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Opacity="0.85"
                                           Text="Min importance (1–5):" />
                                <TextBox Width="48"
                                         Margin="8,0,0,0"
                                         Text="{Binding RoleAutoCaptureMinImportance, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Opacity="0.85"
                                           Text="Min length:" />
                                <TextBox Width="64"
                                         Margin="8,0,0,0"
                                         Text="{Binding RoleAutoCaptureMinLength, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <CheckBox Margin="0,8,0,0"
                                      Content="ROLE CONTEXT block в промпт"
                                      IsChecked="{Binding RoleContextBlockEnabled}" />
                        </StackPanel>

                        <TextBlock Grid.Row="16"
                                   Grid.Column="0"
                                   VerticalAlignment="Top"
                                   Text="Trading episodes"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="16"
                                    Grid.Column="1"
                                    Orientation="Vertical">
                            <CheckBox Content="Экспорт значимых событий в Knowledge/Trading/Episodes"
                                      IsChecked="{Binding TradingExperienceExportEnabled}" />
                            <StackPanel Margin="24,8,0,0" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Opacity="0.85"
                                           Text="PnL threshold:" />
                                <TextBox Width="72"
                                         Margin="8,0,0,0"
                                         Text="{Binding TradingExperiencePnlThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Opacity="0.85"
                                           Text="Drawdown %:" />
                                <TextBox Width="56"
                                         Margin="8,0,0,0"
                                         Text="{Binding TradingExperienceDrawdownThreshold, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="18"
                                   Grid.Column="0"
                                   VerticalAlignment="Top"
                                   Text="Skill generation"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="18"
                                    Grid.Column="1"
                                    Orientation="Vertical">
                            <CheckBox Content="Разрешить сохранение навыков (skill_save JSON → каталог skills)"
                                      IsChecked="{Binding SkillGenerationEnabled}" />
                            <CheckBox Margin="0,8,0,0"
                                      Content="Зеркалировать в WSL ~/.hermes/skills"
                                      IsChecked="{Binding SkillMirrorToWslHermes}"
                                      IsEnabled="{Binding SkillGenerationEnabled}" />
                            <CheckBox Margin="0,8,0,0"
                                      Content="Smoke-test (test_command) перед сохранением"
                                      IsChecked="{Binding SkillRunTestsBeforeSave}"
                                      IsEnabled="{Binding SkillGenerationEnabled}" />
                            <CheckBox Margin="0,8,0,0"
                                      Content="Sandbox: прогон script в temp перед сохранением"
                                      IsChecked="{Binding SkillSandboxBeforeSave}"
                                      IsEnabled="{Binding SkillGenerationEnabled}" />
                            <CheckBox Margin="0,8,0,0"
                                      Content="Автовыбор навыка под задачу (skill resolver в промпт)"
                                      IsChecked="{Binding SkillAutoResolveForTasks}"
                                      IsEnabled="{Binding SkillGenerationEnabled}" />
                            <TextBlock Margin="0,8,0,0"
                                       Opacity="0.72"
                                       Text="Папка skills (пусто = %AppData%\HermesWpf\skills)" />
                            <TextBox Margin="0,4,0,0"
                                     IsEnabled="{Binding SkillGenerationEnabled}"
                                     Text="{Binding GeneratedSkillsDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Grid.Row="20"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Opacity="0.85"
                                   FontWeight="SemiBold"
                                   Text="Скриншот монитора" />

                        <TextBlock Grid.Row="22"
                                   Grid.Column="0"
                                   VerticalAlignment="Top"
                                   Margin="0,4,8,0"
                                   Text="Копия (дубликат)"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="22" Grid.Column="1" VerticalAlignment="Top">
                            <DockPanel LastChildFill="True">
                                <Button Width="92"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Content="Обзор…"
                                        Click="BrowseScreenshotDuplicate_OnClick" />
                                <TextBox VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding DesktopScreenshotDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Margin="0,6,0,0"
                                       Opacity="0.72"
                                       TextWrapping="Wrap"
                                       Text="Пусто — дубликат не создаётся. Основные файлы всегда в %LocalAppData%\HermesWpf\screenshots." />
                        </StackPanel>

                        <TextBlock Grid.Row="24"
                                   Grid.Column="0"
                                   VerticalAlignment="Top"
                                   Margin="0,4,8,0"
                                   Text="Монитор (индекс)"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="24" Grid.Column="1" VerticalAlignment="Top">
                            <TextBox Width="72"
                                     HorizontalAlignment="Left"
                                     LostFocus="ScreenshotMonitorIndex_OnLostFocus"
                                     Text="{Binding DesktopScreenshotMonitorIndexEdit, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0"
                                       Opacity="0.72"
                                       TextWrapping="Wrap"
                                       Text="-1 = основной монитор, 0 = первый, 1 = второй и т.д." />
                        </StackPanel>

                        <TextBlock Grid.Row="26"
                                   Grid.Column="0"
                                   VerticalAlignment="Top"
                                   Margin="0,4,8,0"
                                   Text="Анализ Hermes"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="26"
                                    Grid.Column="1"
                                    VerticalAlignment="Top">
                            <CheckBox Content="После захвата вызывать Hermes CLI (vision_analyze)"
                                      IsChecked="{Binding DesktopVisionAnalyzeEnabled}" />
                            <CheckBox Margin="0,8,0,0"
                                      Content="Для vision_analyze использовать снимок с разметкой (regions.png)"
                                      IsChecked="{Binding DesktopVisionUseAnnotatedImage}"
                                      IsEnabled="{Binding DesktopVisionAnalyzeEnabled}" />
                            <TextBlock Margin="0,6,0,0"
                                       Opacity="0.72"
                                       TextWrapping="Wrap"
                                       Text="Не вызывается при «Пауза агента». Таймаут — Chat timeout в настройках." />
                        </StackPanel>

                        <TextBlock Grid.Row="28"
                                   Grid.Column="0"
                                   VerticalAlignment="Top"
                                   Margin="0,4,8,0"
                                   Text="WordPress"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="28"
                                    Grid.Column="1"
                                    VerticalAlignment="Top">
                            <TextBlock Opacity="0.72"
                                       TextWrapping="Wrap"
                                       Text="Галерея hermes-image-receiver: URL, sender, тестовая отправка файла — в отдельном окне." />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Padding="12,4"
                                    Content="Открыть WordPress…"
                                    Click="OpenWordPressGallery_OnClick" />
                        </StackPanel>

                        <TextBlock Grid.Row="30"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Opacity="0.85"
                                   FontWeight="SemiBold"
                                   Text="Навык: курсор мыши (Windows)" />

                        <TextBlock Grid.Row="32"
                                   Grid.Column="0"
                                   VerticalAlignment="Top"
                                   Margin="0,4,8,0"
                                   Text="Разрешить"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="32"
                                    Grid.Column="1"
                                    Orientation="Vertical"
                                    VerticalAlignment="Top">
                            <CheckBox VerticalAlignment="Center"
                                      Content="Управление курсором из Hermes.Wpf (тест «Навыки», прямые вызовы API)"
                                      IsChecked="{Binding DesktopMouseSkillEnabled}" />
                            <TextBlock Margin="0,8,0,0"
                                       Opacity="0.72"
                                       TextWrapping="Wrap"
                                       Text="Консоль Hermes.MouseBridge не проверяет этот флажок — её запускайте только когда доверяете источнику команд. Координаты — пиксели виртуального экрана." />
                        </StackPanel>

                        <TextBlock Grid.Row="34"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Opacity="0.85"
                                   FontWeight="SemiBold"
                                   Text="Hermes Trading Platform" />

                        <TextBlock Grid.Row="36"
                                   Grid.Column="0"
                                   VerticalAlignment="Top"
                                   Margin="0,4,8,0"
                                   Text="Чат ↔ терминал"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="36"
                                    Grid.Column="1"
                                    Orientation="Vertical"
                                    VerticalAlignment="Top">
                            <CheckBox Content="Интеграция: snapshot и команды trading из чата Hermes.Wpf"
                                      IsChecked="{Binding TradingPlatformIntegrationEnabled}" />
                            <CheckBox Margin="0,8,0,0"
                                      Content="Автозапуск Hermes.TradingPlatform.exe, если heartbeat нет"
                                      IsChecked="{Binding TradingPlatformAutoLaunchTerminal}"
                                      IsEnabled="{Binding TradingPlatformIntegrationEnabled}" />
                            <TextBlock Margin="0,8,0,0"
                                       Opacity="0.72"
                                       TextWrapping="Wrap"
                                       Text="Нужен запущенный терминал (paper trading). Bridge: %LocalAppData%\HermesTrading\bridge\. Ордера проходят RiskValidator в терминале." />
                        </StackPanel>

                        <TextBlock Grid.Row="38"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Opacity="0.85"
                                   FontWeight="SemiBold"
                                   Text="ИИ-помощник (OpenRouter)" />

                        <TextBlock Grid.Row="40"
                                   Grid.Column="0"
                                   VerticalAlignment="Top"
                                   Margin="0,4,8,0"
                                   Text="OpenRouter"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="40"
                                    Grid.Column="1"
                                    Orientation="Vertical"
                                    VerticalAlignment="Top">
                            <TextBox Text="{Binding InAppAssistantOpenRouterApiKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,8,0,0" Opacity="0.85" Text="Model" />
                            <TextBox Margin="0,4,0,0"
                                     Width="320"
                                     HorizontalAlignment="Left"
                                     Text="{Binding InAppAssistantOpenRouterModel, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0"
                                       Opacity="0.72"
                                       TextWrapping="Wrap"
                                       Text="Мини-чат ✦ на любой вкладке. Ключ: openrouter.ai/keys. Бесплатно: openrouter/free или meta-llama/llama-3.2-3b-instruct:free" />
                            <Button Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Padding="12,4"
                                    Content="Сохранить ключ OpenRouter сейчас"
                                    Click="SaveOpenRouterSection_OnClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="10,8"
                        Background="#1E2836"
                        CornerRadius="6">
                    <TextBlock Text="{Binding SettingsStatusText}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Opacity="0.9" />
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">
                    <Button Width="110"
                            Margin="0,0,8,0"
                            Content="Сохранить"
                            Click="SaveButton_OnClick" />
                    <Button Width="100"
                            Content="Close"
                            Click="CloseButton_OnClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
