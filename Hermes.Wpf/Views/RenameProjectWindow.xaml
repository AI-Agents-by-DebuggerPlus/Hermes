<Window x:Class="Hermes.Wpf.Views.RenameProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename project"
        Width="460"
        Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B0E11"
        Foreground="#EAECEF"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Текущее имя" Foreground="#848E9C" FontSize="12" />
        <TextBlock x:Name="CurrentNameText"
                   Grid.Row="2"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="4" Text="Новое имя (имя папки проекта)" Foreground="#848E9C" FontSize="12" />
        <TextBox x:Name="NameBox"
                 Grid.Row="5"
                 Margin="0,6,0,0"
                 Height="32"
                 VerticalContentAlignment="Center"
                 Background="#181A20"
                 Foreground="#EAECEF"
                 BorderBrush="#2B3139"
                 CaretBrush="#F8D12F"
                 KeyDown="NameBox_OnKeyDown" />

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Width="100"
                    Height="30"
                    Margin="0,0,8,0"
                    Content="Cancel"
                    Background="#2B3139"
                    Foreground="#EAECEF"
                    BorderBrush="#383f49"
                    Click="Cancel_OnClick" />
            <Button Width="100"
                    Height="30"
                    Content="Rename"
                    Background="#F0B90B"
                    Foreground="#0B0E11"
                    BorderBrush="#F8D12F"
                    FontWeight="SemiBold"
                    Click="Ok_OnClick" />
        </StackPanel>
    </Grid>
</Window>
