<Window x:Class="Hermes.Wpf.Views.MemoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save experience"
        Height="620"
        Width="640"
        MinHeight="480"
        MinWidth="520"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource HeaderTextStyle}"
                   FontSize="16"
                   Text="Memory editor" />

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Width="100" VerticalAlignment="Center" Text="Type" />
            <ComboBox x:Name="TypeCombo"
                      Width="200"
                      Background="{StaticResource InputBackgroundBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock Width="100" VerticalAlignment="Center" Text="Tags" />
            <TextBox x:Name="TagsBox"
                     Width="480"
                     Background="{StaticResource InputBackgroundBrush}"
                     ToolTip="Comma-separated (# optional)" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <TextBlock Width="100" VerticalAlignment="Center" Text="Project" />
            <TextBox x:Name="ProjectBox"
                     Width="480"
                     Background="{StaticResource InputBackgroundBrush}" />
        </StackPanel>

        <DockPanel Grid.Row="8">
            <StackPanel Margin="0,0,0,8" DockPanel.Dock="Top" Orientation="Horizontal">
                <TextBlock Width="100" VerticalAlignment="Center" Text="Importance" />
                <Slider x:Name="ImportanceSlider"
                        Width="200"
                        IsSnapToTickEnabled="True"
                        Maximum="5"
                        Minimum="1"
                        TickFrequency="1"
                        TickPlacement="BottomRight"
                        Value="3" />
                <TextBlock x:Name="ImportanceLabel"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="3" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,4"
                       Text="Content (Markdown)" />
            <TextBox x:Name="ContentBox"
                     AcceptsReturn="True"
                     Background="{StaticResource InputBackgroundBrush}"
                     FontFamily="Consolas"
                     FontSize="12"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </DockPanel>

        <StackPanel Grid.Row="10"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,10,0"
                    Padding="12,6"
                    Click="Cancel_OnClick"
                    Content="Cancel" />
            <Button Padding="14,6"
                    Click="Save_OnClick"
                    Content="Save to vault"
                    FontWeight="SemiBold"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
