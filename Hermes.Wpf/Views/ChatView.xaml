<UserControl x:Class="Hermes.Wpf.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d">
    <Border Style="{StaticResource PanelBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource HeaderTextStyle}"
                           FontSize="{Binding DataContext.ChatFontSize, ElementName=Root}"
                           Text="Chat" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="{Binding DataContext.ChatFontSize, ElementName=Root}"
                           Foreground="#9CA3AF"
                           Text="{Binding ChatModeStatusText}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChatModeStatusVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <ListBox x:Name="MessagesListBox"
                     Grid.Row="2"
                     FontSize="{Binding DataContext.ChatFontSize, ElementName=Root}"
                     ItemsSource="{Binding Chat.Messages}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ChatMessageListBoxItemStyle}" TargetType="ListBoxItem" />
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="8"
                                BorderBrush="#30343D"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock FontWeight="Bold"
                                           FontSize="{Binding DataContext.ChatFontSize, ElementName=Root}"
                                           Text="{Binding Role}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="{Binding DataContext.ChatFontSize, ElementName=Root}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Left"
                                           Text="{Binding Text}" />
                                <Image Margin="0,8,0,0"
                                       MaxWidth="560"
                                       HorizontalAlignment="Left"
                                       Cursor="Hand"
                                       Stretch="Uniform"
                                       MouseLeftButtonUp="ChatImage_OnMouseLeftButtonUp"
                                       Tag="{Binding ImagePath}"
                                       ToolTip="Нажмите, чтобы открыть в отдельном окне с масштабом"
                                       Source="{Binding ImagePath, Converter={StaticResource FilePathToImageSourceConverter}}"
                                       Visibility="{Binding ImagePath, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="3"
                    Margin="0,8,0,0"
                    Padding="12,8"
                    Background="#1a3a6b"
                    CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFlashcardStatusBarVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Fill="#c9a84c">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FlashcardDotPulse}" Value="True">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock MaxWidth="360"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="{Binding DataContext.ChatFontSize, ElementName=Root}"
                               Foreground="#b0c8ff"
                               Text="{Binding FlashcardStatusText}"
                               TextWrapping="Wrap" />
                    <Button Margin="8,0,0,0"
                            Padding="6,4"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding StopFlashcardsCommand}"
                            Content="✕"
                            Cursor="Hand"
                            FontSize="{Binding DataContext.ChatFontSize, ElementName=Root}"
                            Foreground="#b0c8ff"
                            ToolTip="Остановить цикл карточек" />
                </StackPanel>
            </Border>

            <Border Grid.Row="5"
                    Margin="0,0,0,0"
                    Padding="12,8"
                    Background="#1a4a3a"
                    CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReniWaterStatusBarVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock MaxWidth="420"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="{Binding DataContext.ChatFontSize, ElementName=Root}"
                               Foreground="#b8e8d0"
                               Text="{Binding ReniWaterStatusText}"
                               TextWrapping="Wrap" />
                    <Button Margin="0,0,8,0"
                            Padding="6,4"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ViewReniWaterScreenshotCommand}"
                            Content="Скриншот"
                            Cursor="Hand"
                            FontSize="{Binding DataContext.ChatFontSize, ElementName=Root}"
                            Foreground="#b8e8d0"
                            ToolTip="Открыть скриншот в отдельном окне"
                            Visibility="{Binding CanViewReniWaterScreenshot, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Padding="6,4"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding AckReniWaterCommand}"
                            Content="Подтвердить"
                            Cursor="Hand"
                            FontSize="{Binding DataContext.ChatFontSize, ElementName=Root}"
                            Foreground="#b8e8d0"
                            ToolTip="Остановить напоминания (run_submit -Ack)" />
                </StackPanel>
            </Border>

            <Border Grid.Row="7"
                    Padding="8,6"
                    Background="#161B22"
                    BorderBrush="#30343D"
                    BorderThickness="1"
                    CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAgentChatStatusBarVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="{Binding DataContext.ChatFontSize, ElementName=Root}"
                           FontStyle="Italic"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding AgentChatStatusLine}"
                           TextWrapping="Wrap" />
            </Border>

            <TextBox Grid.Row="9"
                     x:Name="MessageInputTextBox"
                     Height="70"
                     FontSize="{Binding DataContext.ChatFontSize, ElementName=Root}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     PreviewKeyDown="MessageInputTextBox_OnPreviewKeyDown"
                     Text="{Binding Chat.UserInput, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Margin="0,0,8,0"
                        Padding="10,6"
                        FontSize="{Binding DataContext.ChatFontSize, ElementName=Root}"
                        Content="💾 Save experience"
                        Command="{Binding SaveExperienceCommand}"
                        ToolTip="Сохранить последнюю связку вопрос/ответ в память vault" />
                <Button Width="120"
                        Margin="0,0,8,0"
                        FontSize="{Binding DataContext.ChatFontSize, ElementName=Root}"
                        Content="Analyze Code"
                        Command="{Binding AnalyzeCodeCommand}" />
                <Button Width="100"
                        FontSize="{Binding DataContext.ChatFontSize, ElementName=Root}"
                        Content="Send"
                        Command="{Binding SendMessageCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
