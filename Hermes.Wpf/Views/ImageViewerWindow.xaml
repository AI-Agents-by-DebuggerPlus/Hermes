<Window x:Class="Hermes.Wpf.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скриншот"
        Height="720"
        Width="960"
        MinHeight="400"
        MinWidth="520"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        KeyDown="Window_OnKeyDown"
        ContentRendered="Window_OnContentRendered">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PathText"
                   Grid.Row="0"
                   FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, ElementName=PathText}" />

        <Border Grid.Row="2"
                Background="#0d1117"
                BorderBrush="#30343D"
                BorderThickness="1"
                CornerRadius="6">
            <ScrollViewer x:Name="Scroller"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="Scroller_OnPreviewMouseWheel">
                <Image x:Name="Photo"
                       RenderTransformOrigin="0.5,0.5"
                       Stretch="None" />
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button MinWidth="36"
                        Margin="0,0,6,0"
                        Padding="8,4"
                        Click="ZoomOut_OnClick"
                        Content="−"
                        ToolTip="Уменьшить" />
                <Slider x:Name="ZoomSlider"
                        Width="160"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Maximum="400"
                        Minimum="25"
                        Value="100"
                        TickFrequency="25"
                        IsSnapToTickEnabled="False"
                        ValueChanged="ZoomSlider_OnValueChanged" />
                <Button MinWidth="36"
                        Margin="0,0,6,0"
                        Padding="8,4"
                        Click="ZoomIn_OnClick"
                        Content="+"
                        ToolTip="Увеличить (колесо мыши)" />
                <Button MinWidth="52"
                        Margin="0,0,6,0"
                        Padding="8,4"
                        Click="ZoomReset_OnClick"
                        Content="100%"
                        ToolTip="Исходный размер" />
                <Button MinWidth="72"
                        Padding="8,4"
                        Click="ZoomFit_OnClick"
                        Content="В окно"
                        ToolTip="Вписать в окно" />
            </StackPanel>
            <TextBlock x:Name="ZoomLabel"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Right"
                       FontSize="13"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="100%" />
        </DockPanel>
    </Grid>
</Window>
