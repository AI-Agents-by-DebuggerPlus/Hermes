<Window x:Class="Hermes.Wpf.Views.SupabaseTestChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supabase test chat"
        Height="560"
        Width="640"
        MinHeight="420"
        MinWidth="520"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Opacity="0.85"
                   Text="Только таблица messages в Supabase. Hermes CLI не вызывается. Подключение и ошибки пишутся в сессионный лог (Logs)." />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="URL" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SupabaseUrlEdit, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Anon key" />
            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     MinHeight="28"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     Text="{Binding SupabaseAnonKeyEdit, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Sender name" />
            <TextBox Grid.Row="4"
                     Grid.Column="1"
                     Width="200"
                     HorizontalAlignment="Left"
                     Text="{Binding TestSenderName, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox Grid.Row="6"
                      Grid.Column="1"
                      Content="Анонимный вход (GoTrue)"
                      IsChecked="{Binding UseAnonymousAuth}" />
        </Grid>

        <ListBox Grid.Row="4"
                 FontFamily="Consolas"
                 FontSize="12"
                 ItemsSource="{Binding Lines}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <TextBox Grid.Row="6"
                 MinHeight="64"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding DraftMessage, UpdateSourceTrigger=PropertyChanged}" />

        <DockPanel Grid.Row="8" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Width="360"
                       Margin="0,0,12,0"
                       Text="{Binding Status}" />
            <Button DockPanel.Dock="Right"
                    Width="100"
                    Margin="6,0,0,0"
                    Content="В настройки"
                    Command="{Binding SyncToSettingsCommand}"
                    ToolTip="Скопировать URL/key/флаги в объект настроек (сохраните Settings или закройте это окно — главное окно может сохранить)." />
            <Button DockPanel.Dock="Right"
                    Width="92"
                    Margin="6,0,0,0"
                    Content="Обновить"
                    Command="{Binding RefreshCommand}" />
            <Button DockPanel.Dock="Right"
                    Width="92"
                    Margin="6,0,0,0"
                    Content="Отправить"
                    Command="{Binding SendCommand}" />
            <Button DockPanel.Dock="Right"
                    Width="100"
                    Margin="6,0,0,0"
                    Content="Отключить"
                    Command="{Binding DisconnectCommand}" />
            <Button DockPanel.Dock="Right"
                    Width="110"
                    Content="Подключиться"
                    Command="{Binding ConnectCommand}" />
        </DockPanel>
    </Grid>
</Window>
