<Window x:Class="Hermes.Wpf.Views.HermesErrorHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes — ошибка"
        Width="540"
        Height="480"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#0B0E11"
        Foreground="#EAECEF"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        Topmost="True">
    <Border BorderBrush="#FF6B6B" BorderThickness="1" Background="#181A20" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="0.8*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="1.2*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <TextBlock x:Name="TitleText"
                           DockPanel.Dock="Left"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#FF6B6B"
                           TextWrapping="Wrap"
                           Text="Ошибка Hermes" />
                <Button DockPanel.Dock="Right"
                        Width="28"
                        Height="28"
                        Content="×"
                        FontSize="16"
                        Background="Transparent"
                        Foreground="#848E9C"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Close_OnClick" />
            </DockPanel>

            <TextBlock Grid.Row="2" Text="Текст ошибки" Foreground="#848E9C" FontSize="11" />
            <TextBox x:Name="RawErrorBox"
                     Grid.Row="4"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Background="#0B0E11"
                     Foreground="#EAECEF"
                     BorderBrush="#2B3139"
                     Padding="8"
                     FontSize="12" />

            <TextBlock Grid.Row="6" Text="Что это значит" Foreground="#848E9C" FontSize="11" />
            <TextBox x:Name="ExplanationBox"
                     Grid.Row="8"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Background="#0B0E11"
                     Foreground="#EAECEF"
                     BorderBrush="#2B3139"
                     Padding="8"
                     FontSize="13" />

            <TextBlock Grid.Row="10" Text="Как устранить" Foreground="#848E9C" FontSize="11" />
            <TextBox x:Name="FixBox"
                     Grid.Row="12"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Background="#0B0E11"
                     Foreground="#EAECEF"
                     BorderBrush="#2B3139"
                     Padding="8"
                     FontSize="13" />

            <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="120"
                        Height="32"
                        Content="Понятно"
                        Background="#F0B90B"
                        Foreground="#0B0E11"
                        BorderBrush="#F8D12F"
                        FontWeight="SemiBold"
                        IsDefault="True"
                        Click="Close_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
