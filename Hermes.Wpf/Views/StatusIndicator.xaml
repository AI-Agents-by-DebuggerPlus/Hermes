<UserControl x:Class="Hermes.Wpf.Views.StatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Style="{StaticResource PanelBorderStyle}">
        <DockPanel LastChildFill="True">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Ellipse Width="12" Height="12" Fill="{Binding CurrentConnectionState, Converter={StaticResource ConnectionStateToColorConverter}}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding ConnectionStatusMessage}" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Width="90"
                    Content="Reconnect"
                    Command="{Binding ReconnectCommand}" />
        </DockPanel>
    </Border>
</UserControl>
