<UserControl x:Class="Hermes.Wpf.Views.StatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelBorderStyle}">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Hermes -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <Ellipse Width="10"
                         Height="10"
                         VerticalAlignment="Center"
                         Fill="{Binding CurrentConnectionState, Converter={StaticResource ConnectionStateToColorConverter}}" />
                <TextBlock Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Hermes"
                           ToolTip="Состояние preflight Hermes CLI (WSL)." />
            </StackPanel>

            <!-- Preflight/Reconnect message + tutors ribbon -->
            <Grid Grid.Column="1"
                  VerticalAlignment="Center"
                  Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="{Binding ConnectionStatusMessage}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ConnectionStatusMessage}" />

                    <Button Grid.Column="1"
                            MinWidth="92"
                            Margin="12,0,0,0"
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Command="{Binding ReconnectCommand}"
                            Content="Reconnect"
                            ToolTip="Повторить preflight и проверку Hermes (WSL / CLI)." />
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="#7DD3FC"
                           Text="{Binding EnglishTutorStatusRibbonText}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnglishTutorStatusVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Row="2"
                           Margin="0,4,0,0"
                           FontSize="11"
                           Foreground="#86EFAC"
                           Text="{Binding TradingModeStatusRibbonText}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTradingModeStatusVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Supabase -->
            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Margin="4,0,4,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Supabase"
                           ToolTip="Supabase relay — зеркало чата через таблицу messages для Android и др. клиентов (URL и anon key в Settings)." />
                <Ellipse Width="9"
                         Height="9"
                         VerticalAlignment="Center"
                         Stroke="#30343D"
                         StrokeThickness="1"
                         ToolTip="{Binding SupabaseRelayToolTipShort}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#484F58" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SupabaseIndicatorState}" Value="Live">
                                    <Setter Property="Fill" Value="#3FB950" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SupabaseIndicatorState}" Value="Idle">
                                    <Setter Property="Fill" Value="#D29922" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SupabaseIndicatorState}" Value="Off">
                                    <Setter Property="Fill" Value="#484F58" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock MinWidth="88"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           ToolTip="{Binding SupabaseRelayToolTipShort}"
                           Text="{Binding SupabaseRelayStatusText}" />

                <Button Margin="12,0,0,0"
                        Padding="8,4"
                        MinWidth="96"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleSupabaseRelayCommand}"
                        Content="{Binding SupabaseRelayToggleCaption}"
                        FontSize="12"
                        ToolTip="{Binding SupabaseRelayToggleHint}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
