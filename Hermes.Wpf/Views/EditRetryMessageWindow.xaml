<Window x:Class="Hermes.Wpf.Views.EditRetryMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit &amp; retry"
        Width="560"
        Height="340"
        MinWidth="420"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        Background="#0B0E11"
        Foreground="#EAECEF"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Последнее сообщение — отредактируйте перед повторной отправкой в Hermes"
                   Foreground="#848E9C"
                   FontSize="12"
                   TextWrapping="Wrap" />

        <TextBox x:Name="BodyBox"
                 Grid.Row="2"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="#181A20"
                 Foreground="#EAECEF"
                 BorderBrush="#2B3139"
                 CaretBrush="#F8D12F"
                 Padding="8"
                 FontSize="14" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Width="100"
                    Height="30"
                    Margin="0,0,8,0"
                    Content="Cancel"
                    Background="#2B3139"
                    Foreground="#EAECEF"
                    BorderBrush="#383f49"
                    IsCancel="True"
                    Click="Cancel_OnClick" />
            <Button Width="140"
                    Height="30"
                    Content="Send again"
                    Background="#F0B90B"
                    Foreground="#0B0E11"
                    BorderBrush="#F8D12F"
                    FontWeight="SemiBold"
                    IsDefault="True"
                    Click="Ok_OnClick" />
        </StackPanel>
    </Grid>
</Window>
